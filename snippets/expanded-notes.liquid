{% comment %}
  expanded-notes: "Nuty zapachowe i składniki" accordion (details#expanded-notes is a JS/anchor target, keep the id).
  Params:
    premium: true renders a bare <details> row for a pm-accordion wrapper (editorial product page);
             anything else keeps Dawn's product__accordion wrapper (product.json, custom-bundle).
  Notes come from product metafields custom.top_notes / middle_notes / base_notes (metaobject with heading +
  description on this store; list and text shapes are read too). A tier renders only when it has text;
  the tier block is skipped when all three are blank.
{% endcomment %}
{%- liquid
  assign notes_premium = false
  if premium == true
    assign notes_premium = true
  endif

  assign note_top = ''
  assign note_heart = ''
  assign note_base = ''
  assign note_top_desc = ''
  assign note_heart_desc = ''
  assign note_base_desc = ''

  assign mf = product.metafields.custom.top_notes
  if mf != blank
    if mf.type contains 'list.'
      capture note_top
        for n in mf.value
          echo n.heading | default: n.name | default: n
          unless forloop.last
            echo ', '
          endunless
        endfor
      endcapture
    elsif mf.type == 'metaobject_reference'
      assign note_top = mf.value.heading | default: mf.value.name
      assign note_top_desc = mf.value.description
    else
      assign note_top = mf.value | strip_html
    endif
  endif

  assign mf = product.metafields.custom.middle_notes
  if mf != blank
    if mf.type contains 'list.'
      capture note_heart
        for n in mf.value
          echo n.heading | default: n.name | default: n
          unless forloop.last
            echo ', '
          endunless
        endfor
      endcapture
    elsif mf.type == 'metaobject_reference'
      assign note_heart = mf.value.heading | default: mf.value.name
      assign note_heart_desc = mf.value.description
    else
      assign note_heart = mf.value | strip_html
    endif
  endif

  assign mf = product.metafields.custom.base_notes
  if mf != blank
    if mf.type contains 'list.'
      capture note_base
        for n in mf.value
          echo n.heading | default: n.name | default: n
          unless forloop.last
            echo ', '
          endunless
        endfor
      endcapture
    elsif mf.type == 'metaobject_reference'
      assign note_base = mf.value.heading | default: mf.value.name
      assign note_base_desc = mf.value.description
    else
      assign note_base = mf.value | strip_html
    endif
  endif

  assign note_top = note_top | strip
  assign note_heart = note_heart | strip
  assign note_base = note_base | strip
  assign note_top_desc = note_top_desc | strip
  assign note_heart_desc = note_heart_desc | strip
  assign note_base_desc = note_base_desc | strip

  assign has_tiers = false
  if note_top != blank or note_heart != blank or note_base != blank
    assign has_tiers = true
  endif
-%}
{%- if notes_premium -%}
  <details id="expanded-notes" class="pm-accordion__item quick-add-hidden">
    <summary aria-controls="ProductAccordion-expanded-notes">
      <h2 class="pm-accordion__title">Nuty zapachowe i składniki</h2>
    </summary>
    <div class="pm-accordion__content rte" id="ProductAccordion-expanded-notes">
      <div class="scent-notes-panel pm-notes">
        {%- if product.metafields.custom.main_notes.value != blank -%}
          <div class="pm-notes__main">
            <p class="pm-notes__caption">Główne nuty</p>
            <div class="pm-notes__row">
              {%- for note in product.metafields.custom.main_notes.value -%}
                <figure class="pm-notes__figure">
                  <img src="{{ note.icon | image_url: width: 64 }}" alt="{{ note.name | escape }}" width="34" height="34" loading="lazy">
                  <figcaption>{{ note.name }}</figcaption>
                </figure>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if has_tiers -%}
          <div class="pm-notes__tiers">
            {%- if note_top != blank -%}
              <div class="pm-notes__tier">
                <svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
                  <path d="M7 5 h6 v2 h-6 z"></path>
                  <rect x="4" y="7" width="12" height="18" rx="2"></rect>
                </svg>
                <div class="min-w-0">
                  <p><strong>{{ 'premium.pdp.top' | t }}:</strong> {{ note_top }}</p>
                  {%- if note_top_desc != blank -%}
                    <p>{{ note_top_desc }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if note_heart != blank -%}
              <div class="pm-notes__tier">
                <svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
                  <path d="M7 5 h6 v2 h-6 z"></path>
                  <rect x="4" y="7" width="12" height="18" rx="2"></rect>
                  <rect x="4" y="14" width="12" height="11" rx="2" fill="currentColor" fill-opacity="0.2"></rect>
                </svg>
                <div class="min-w-0">
                  <p><strong>{{ 'premium.pdp.heart' | t }}:</strong> {{ note_heart }}</p>
                  {%- if note_heart_desc != blank -%}
                    <p>{{ note_heart_desc }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if note_base != blank -%}
              <div class="pm-notes__tier">
                <svg width="20" height="28" viewBox="0 0 20 28" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
                  <path d="M7 5 h6 v2 h-6 z"></path>
                  <rect x="4" y="7" width="12" height="18" rx="2"></rect>
                  <rect x="4" y="7" width="12" height="18" rx="2" fill="currentColor" fill-opacity="0.35"></rect>
                </svg>
                <div class="min-w-0">
                  <p><strong>{{ 'premium.pdp.base' | t }}:</strong> {{ note_base }}</p>
                  {%- if note_base_desc != blank -%}
                    <p>{{ note_base_desc }}</p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <p class="pm-notes__ingredients">
          <strong>Składniki:</strong>
          {% if product.metafields.custom.ingredients.value != blank %}
            {{ product.metafields.custom.ingredients.value | metafield_text }}
          {% else %}
            Alkohol denaturowany, kompozycja zapachowa, woda, limonen, linalol,
            Citronellol, Geraniol, Citral, salicylan benzylu, kumaryna,
            alfa-izometylojonon, aldehyd heksylocynamonowy, benzoesan benzylu.
          {% endif %}
        </p>

        <div class="pm-notes__tags">
          <span class="pm-notes__tag">
            {% render 'pm-icon', icon: 'leaf', size: 14, stroke: 1.5 %}
            Wegańskie
          </span>
          <span class="pm-notes__tag">
            {% render 'pm-icon', icon: 'heart', size: 14, stroke: 1.5 %}
            Nietestowane na zwierzętach
          </span>
          <span class="pm-notes__tag">
            {% render 'pm-icon', icon: 'check', size: 14, stroke: 1.5 %}
            Czyste składniki
          </span>
        </div>
      </div>
    </div>
  </details>
{%- else -%}
<div class="product__accordion accordion quick-add-hidden">
  <details id="expanded-notes">
    <summary
      role="button"
      aria-expanded="false"
      aria-controls="ProductAccordion-expanded-notes"
    >
      <div class="summary__title">
        <h2 class="h4 accordion__title inline-richtext">Nuty zapachowe i składniki</h2>
      </div>
      <svg
        aria-hidden="true"
        focusable="false"
        class="icon icon-caret"
        viewBox="0 0 10 6"
      >
        <path
          fill-rule="evenodd"
          clip-rule="evenodd"
          d="M9.354.646a.5.5 0 00-.708 0L5 4.293 1.354.646a.5.5 0 00-.708.708l4 4a.5.5 0 00.708 0l4-4a.5.5 0 000-.708z"
          fill="currentColor"
        ></path>
      </svg>
    </summary>

    <div
      class="accordion__content rte"
      id="ProductAccordion-expanded-notes"
    >
      <div class="scent-notes-panel mgx-text">
        <div class="mb-5">
          <p class="text-xs mgx-text-muted mb-3 m-0">Główne nuty:</p>
          <div class="flex flex-wrap gap-x-6">
            {% for note in product.metafields.custom.main_notes.value %}
              <figure class="m-0 flex flex-col items-center text-center">
                <div class="h-16 mb-2 flex items-end justify-center">
                  <img
                    class="!border-0 [filter:grayscale(100%)]"
                    src="{{ note.icon | image_url: width: 64 }}"
                    alt="{{ note.name }}"
                    width="34"
                    height="34"
                  >
                </div>
                <figcaption class="text-sm m-0">{{ note.name }}</figcaption>
              </figure>
            {% endfor %}
          </div>
        </div>

        <hr class="border-0 border-b border-solid mgx-border my-4">

        <div class="space-y-3">

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="28"
              viewBox="0 0 20 28"
              class="mgx-text-muted shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
              <path d="M7 5 h6 v2 h-6 z"></path>
              <rect x="4" y="7" width="12" height="18" rx="2"></rect>
            </svg>
            <div class="min-w-0">
              <p class="text-sm m-0">
                <strong class="font-bold">Nuty głowy:</strong>
                {{ product.metafields.custom.top_notes.value.heading }}
              </p>
              <p class="text-sm mgx-text-muted m-0">
                {{ product.metafields.custom.top_notes.value.description }}
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="28"
              viewBox="0 0 20 28"
              class="mgx-text-muted shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
              <path d="M7 5 h6 v2 h-6 z"></path>
              <rect x="4" y="7" width="12" height="18" rx="2"></rect>
              <rect
                x="4"
                y="14"
                width="12"
                height="11"
                rx="2"
                fill="currentColor"
                fill-opacity="0.2"
              ></rect>
            </svg>
            <div class="min-w-0">
              <p class="text-sm m-0">
                <strong class="font-bold">Nuty serca:</strong>
                {{ product.metafields.custom.middle_notes.value.heading }}
              </p>
              <p class="text-sm mgx-text-muted m-0">
                {{ product.metafields.custom.middle_notes.value.description }}
              </p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg
              width="20"
              height="28"
              viewBox="0 0 20 28"
              class="mgx-text-muted shrink-0 mt-0.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <rect x="8" y="2" width="4" height="3" rx="0.5"></rect>
              <path d="M7 5 h6 v2 h-6 z"></path>
              <rect x="4" y="7" width="12" height="18" rx="2"></rect>
              <rect
                x="4"
                y="7"
                width="12"
                height="18"
                rx="2"
                fill="currentColor"
                fill-opacity="0.35"
              ></rect>
            </svg>
            <div class="min-w-0">
              <p class="text-sm m-0">
                <strong class="font-bold">Nuty bazy:</strong>
                {{ product.metafields.custom.base_notes.value.heading }}
              </p>
              <p class="text-sm mgx-text-muted m-0">
                {{ product.metafields.custom.base_notes.value.description }}
              </p>
            </div>
          </div>
        </div>

        <hr class="border-0 border-b border-solid mgx-border my-4">

        <p class="text-xs leading-relaxed mgx-text-muted mb-4 m-0">
          <strong class="font-bold">Składniki:</strong>
          {% if product.metafields.custom.ingredients.value != blank %}
            {{ product.metafields.custom.ingredients.value | metafield_text }}
          {% else %}
            Alkohol denaturowany, kompozycja zapachowa, woda, limonen, linalol,
            Citronellol, Geraniol, Citral, salicylan benzylu, kumaryna,
            alfa-izometylojonon, aldehyd heksylocynamonowy, benzoesan benzylu.
          {% endif %}
        </p>

        <div class="flex flex-wrap gap-2 mt-4">
          <span class="inline-flex items-center whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-solid mgx-border text-xs mgx-text">
            <svg
              class="w-3.5 h-3.5 mr-1.5 mgx-text-accent"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d="M10 2 C7 5 4 8 4 12 C4 16 7 18 10 18 C13 18 16 16 16 12 C16 8 13 5 10 2 Z"></path>
            </svg>
            Wegańskie
          </span>

          <span class="inline-flex items-center whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-solid mgx-border text-xs mgx-text">
            Nietestowane na zwierzętach
            <svg
              class="w-4 h-4 ml-1.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              aria-hidden="true"
            >
              <circle cx="12" cy="13" r="5"></circle>
              <ellipse cx="8" cy="7" rx="1.6" ry="2.4"></ellipse>
              <ellipse cx="16" cy="7" rx="1.6" ry="2.4"></ellipse>
              <ellipse cx="5" cy="11" rx="1.4" ry="1.8"></ellipse>
              <ellipse cx="19" cy="11" rx="1.4" ry="1.8"></ellipse>
            </svg>
          </span>

          <span class="inline-flex items-center whitespace-nowrap px-3 py-1.5 rounded-full bg-white border border-solid mgx-border text-xs mgx-text">
            <svg
              class="w-3.5 h-3.5 mr-1.5 mgx-text-accent"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path d="M5 10 l3 3 l7-7"></path>
            </svg>
            Czyste składniki
          </span>
        </div>
      </div>
    </div>
  </details>
</div>
{%- endif -%}

{%- comment -%}
  One scent-notes tile (pdp-scent-notes).
  Accepts:
  - label: layer label, e.g. Top notes
  - name: ingredient shown on the tile
  - file: filename of the note photo in this store's Files (Content > Files), magyx-note-<key>.jpg (optional)
  - image: image or media_image object (optional; used when there is no file)
{%- endcomment -%}
{%- liquid
  assign note_img = blank
  if file != blank
    assign note_img = images[file]
  endif
  if note_img == blank and image != blank
    assign note_img = image
  endif
-%}
<li class="pm-scent__tile{% if note_img != blank %} pm-scent__tile--image{% endif %}">
  {%- if note_img != blank -%}
    {{ note_img | image_url: width: 800 | image_tag: widths: '400, 600, 800', sizes: '(min-width: 1216px) 384px, (min-width: 750px) 32vw, 100vw', loading: 'lazy', alt: '', class: 'pm-scent__img' }}
  {%- endif -%}
  <p class="pm-scent__label">{{ label }}</p>
  <p class="pm-scent__name">{{ name }}</p>
</li>

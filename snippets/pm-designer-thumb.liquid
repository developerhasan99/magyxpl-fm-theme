{% comment %}
  Designer bottle tile for an "Inspired by" line (custom.inspired_by -> inspiration metaobject image).
  Renders nothing when the product has no bottle, so the caller's text line stays as it was.
  Wrap the line in .pm-dmeta and the text in .pm-dmeta__text (styles in pm-card.css).

  Accepts:
  - product: {Object} product (required)
{% endcomment %}
{%- assign pm_dt_img = product.metafields.custom.inspired_by.value.image.value -%}
{%- if pm_dt_img != blank -%}
  <span class="pm-dthumb" aria-hidden="true">
    {{- pm_dt_img | image_url: width: 96 | image_tag: width: 48, height: 48, loading: 'lazy', alt: '', class: 'pm-dthumb__img' -}}
  </span>
{%- endif -%}

{{ 'pm-s-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pm-reviews.js' | asset_url }}" defer="defer"></script>
{%- comment -%}
  Theme-owned customer reviews (replaces the Judge.me review widget). FM look: band heading + store rating, a summary
  (average, stars, 5 to 1 histogram that filters the list), white cards from pm-sections.css (.pm-review), load more.
  Server side: heading, summary and histogram (numbers from snippets/pm-review-stats, generated by
  scripts/build_reviews.py). Client side (assets/pm-reviews.js): the cards, rendered from assets/pm-reviews.json,
  fetched once per page when the section comes within 600px of the viewport.
  Modes: product = this product's reviews first, then the rest (behaves like all outside a product page);
         all = every review, newest first; shop = store reviews only (summary recounted from those).
  Root carries id="reviews": the buy box rating links to #reviews.
{%- endcomment -%}
{%- liquid
  capture pm_rv_avg
    render 'pm-review-stats', mode: 'store_avg'
  endcapture
  capture pm_rv_count
    render 'pm-review-stats', mode: 'store_count'
  endcapture
  capture pm_rv_hist
    render 'pm-review-stats', mode: 'store_hist'
  endcapture
  assign pm_rv_avg = pm_rv_avg | strip | plus: 0
  assign pm_rv_count = pm_rv_count | strip | plus: 0
  assign pm_rv_hist = pm_rv_hist | strip | split: ','
  assign pm_rv_avg_big = pm_rv_avg | round: 2 | append: '' | replace: '.', ','
  assign pm_rv_avg_short = pm_rv_avg | round: 1 | append: '' | replace: '.', ','

  assign pm_rv_mode = section.settings.mode | default: 'product'
  assign pm_rv_handle = ''
  if pm_rv_mode == 'product' and product != blank
    assign pm_rv_handle = product.handle
  endif

  assign pm_rv_heading = section.settings.heading
  if pm_rv_heading == blank
    assign pm_rv_heading = 'premium.reviews.heading' | t
  endif

  assign pm_rv_data_url = 'pm-reviews.json' | asset_url
  assign pm_rv_asset_base = pm_rv_data_url | split: 'pm-reviews.json' | first

  assign pm_rv_initial = section.settings.initial_count | default: 6
  assign pm_rv_more = section.settings.load_more_count | default: 6
  assign pm_rv_cols = section.settings.columns_desktop | default: '2'
  assign pm_rv_bundle = false
  if template.suffix == 'bundle-save'
    assign pm_rv_bundle = true
    assign pm_rv_cols = section.settings.columns_bundle_page | default: '3'
  endif

  assign pm_rv_lang = request.locale.iso_code | default: 'pl'
-%}
{%- style -%}
  .premium .pm-rv--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .premium .pm-rv--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<pm-reviews
  id="reviews"
  class="pm-reviews pm-rv pm-rv--{{ section.id }}{% if pm_rv_bundle %} pm-rv--bundle{% endif %} color-{{ section.settings.color_scheme }} gradient"
  data-mode="{{ pm_rv_mode }}"
  data-product-handle="{{ pm_rv_handle | escape }}"
  data-asset-base="{{ pm_rv_asset_base }}"
  data-src="{{ pm_rv_data_url }}"
  data-cols="{{ pm_rv_cols }}"
  data-initial="{{ pm_rv_initial }}"
  data-more="{{ pm_rv_more }}">
  <div class="page-width">
    <div class="pm-rv__head">
      <h2 class="pm-h2 pm-rv__heading">{{ pm_rv_heading | escape }}</h2>
      {%- comment -%} The small heading rating only when the big summary is off (no duplicate numbers) {%- endcomment -%}
      {%- if pm_rv_count > 0 and section.settings.show_summary == false -%}
        <p class="pm-rv__head-rating">
          {%- render 'pm-stars', rating: pm_rv_avg_short, size: 12 -%}
          <span class="pm-small pm-muted" data-pm-rv-head>
            {{- pm_rv_avg_short }} · {{ 'premium.reviews.count' | t: count: pm_rv_count -}}
          </span>
        </p>
      {%- endif -%}
    </div>

    {%- if section.settings.show_summary and pm_rv_count > 0 -%}
      <div class="pm-rv__summary">
        <div class="pm-rv__score">
          <p class="pm-rv__avg" data-pm-rv-avg>{{ pm_rv_avg_big }}</p>
          <div class="pm-rv__score-meta">
            <span
              class="pm-review__stars pm-rv__score-stars"
              role="img"
              aria-label="{{ 'premium.reviews.rating_aria' | t: rating: pm_rv_avg_short }}"
              data-pm-rv-avg-stars>
              {%- for i in (1..5) -%}
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              {%- endfor -%}
            </span>
            <p class="pm-small pm-muted pm-rv__based" data-pm-rv-based>
              {{- 'premium.reviews.based_on' | t: count: pm_rv_count -}}
            </p>
          </div>
        </div>

        <div class="pm-rv__hist" role="group" aria-label="{{ 'premium.reviews.histogram_label' | t | escape }}">
          {%- for pm_rv_row in pm_rv_hist -%}
            {%- liquid
              assign pm_rv_star = pm_rv_row | split: ':' | first | plus: 0
              assign pm_rv_n = pm_rv_row | split: ':' | last | plus: 0
              assign pm_rv_pct = 0
              if pm_rv_count > 0
                assign pm_rv_pct = pm_rv_n | times: 100.0 | divided_by: pm_rv_count | round: 1
              endif
            -%}
            <button
              type="button"
              class="pm-rv__bar"
              data-pm-rv-star="{{ pm_rv_star }}"
              aria-pressed="false"
              aria-label="{{ 'premium.reviews.filter_aria' | t: stars: pm_rv_star, count: pm_rv_n | escape }}"
              {% if pm_rv_n == 0 %}
                disabled
              {% endif %}
            >
              <span class="pm-rv__bar-label" aria-hidden="true">
                {{- pm_rv_star -}}
                <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              </span>
              <span class="pm-rv__track" aria-hidden="true">
                <span class="pm-rv__fill" style="--pm-rv-pct: {{ pm_rv_pct }}%;" data-pm-rv-fill></span>
              </span>
              <span class="pm-rv__bar-count" aria-hidden="true" data-pm-rv-n>{{ pm_rv_n }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pm-rv__filter" data-pm-rv-filter hidden>
      <span class="pm-small" data-pm-rv-filter-text></span>
      <button type="button" class="pm-rv__clear" data-pm-rv-clear>{{ 'premium.reviews.clear_filter' | t }}</button>
    </div>
    <p class="visually-hidden" role="status" aria-live="polite" data-pm-rv-status></p>

    <div
      class="pm-rv__list"
      role="list"
      aria-label="{{ pm_rv_heading | escape }}"
      aria-busy="true"
      data-pm-rv-list></div>

    <p class="pm-rv__note pm-small pm-muted" data-pm-rv-loading>{{ 'premium.reviews.loading' | t }}</p>
    <p class="pm-rv__note pm-small pm-muted" data-pm-rv-empty hidden>{{ 'premium.reviews.empty' | t }}</p>
    <p class="pm-rv__note pm-small pm-muted" data-pm-rv-error hidden>{{ 'premium.reviews.error' | t }}</p>

    <div class="pm-rv__more" data-pm-rv-more-wrap hidden>
      <button type="button" class="pm-btn pm-btn--secondary" data-pm-rv-more>{{ 'premium.reviews.load_more' | t }}</button>
    </div>
  </div>

  <dialog class="pm-rv__dialog" aria-label="{{ 'premium.reviews.photo_dialog' | t | escape }}" data-pm-rv-dialog>
    <button type="button" class="pm-rv__dialog-close" aria-label="{{ 'premium.general.close' | t | escape }}" data-pm-rv-dialog-close>
      {%- render 'pm-icon', icon: 'close', size: 20 -%}
    </button>
    <img class="pm-rv__dialog-img" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" alt="" width="1" height="1" data-pm-rv-dialog-img>
  </dialog>

  <script type="application/json" data-pm-rv-config>
    {
      "lang": {{ pm_rv_lang | json }},
      "root": {{ routes.root_url | json }},
      "t": {
        "count": {
          "one": {{ 'premium.reviews.count' | t: count: 1 | json }},
          "few": {{ 'premium.reviews.count' | t: count: 2 | json }},
          "many": {{ 'premium.reviews.count' | t: count: 5 | json }},
          "other": {{ 'premium.reviews.count' | t: count: 5 | json }}
        },
        "based_on": {
          "one": {{ 'premium.reviews.based_on' | t: count: 1 | json }},
          "few": {{ 'premium.reviews.based_on' | t: count: 2 | json }},
          "many": {{ 'premium.reviews.based_on' | t: count: 5 | json }},
          "other": {{ 'premium.reviews.based_on' | t: count: 5 | json }}
        },
        "rating_aria": {{ 'premium.reviews.rating_aria' | t: rating: '[rating]' | json }},
        "filter_aria": {{ 'premium.reviews.filter_aria' | t: stars: '[stars]', count: '[count]' | json }},
        "filter_on": {{ 'premium.reviews.filter_on' | t: stars: '[stars]', count: '[count]' | json }},
        "filter_off": {{ 'premium.reviews.filter_off' | t: count: '[count]' | json }},
        "shown": {{ 'premium.reviews.shown' | t: shown: '[shown]', total: '[total]' | json }},
        "verified": {{ 'premium.reviews.verified' | t | json }},
        "product_line": {{ 'premium.reviews.product_line' | t: title: '[title]' | json }},
        "photo_open": {{ 'premium.reviews.photo_open' | t: index: '[index]', name: '[name]' | json }},
        "photo_alt": {{ 'premium.reviews.photo_alt' | t: name: '[name]' | json }}
      }
    }
  </script>
</pm-reviews>

{% schema %}
{
  "name": "Reviews (theme)",
  "tag": "section",
  "class": "section pm-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opinie klientów"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Show summary (average + rating breakdown)",
      "default": true
    },
    {
      "type": "select",
      "id": "mode",
      "label": "Reviews",
      "options": [
        { "value": "product", "label": "This product first, then all" },
        { "value": "all", "label": "All reviews" },
        { "value": "shop", "label": "Store reviews only" }
      ],
      "default": "product",
      "info": "Outside a product page \"This product first\" shows all reviews."
    },
    {
      "type": "range",
      "id": "initial_count",
      "label": "Reviews shown at first",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "load_more_count",
      "label": "Reviews added per \"Show more\"",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns from 990px",
      "options": [
        { "value": "1", "label": "1 (list, Judge.me layout)" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "columns_bundle_page",
      "label": "Kolumny od 990px na stronie Zestaw (jak FM)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Reviews (theme)"
    }
  ]
}
{% endschema %}

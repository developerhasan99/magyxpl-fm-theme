            return tokens.every(function (t) { return hay.indexOf(' ' + t) !== -1; });
          },

          /* Picks */
          qty: function (vid) {
            var key = String(vid);
            return this.picks.filter(function (p) { return p === key; }).length;
          },
          add: function (vid) {
            if (this.atMax) return;
            this.picks.push(String(vid));
            this.bumpTier();
            this.error = '';
          },
          remove: function (vid) {
            var i = this.picks.lastIndexOf(String(vid));

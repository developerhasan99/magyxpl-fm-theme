          /* Value summary above the CTA (cents, shopper's currency). The designer line only shows when every
             pick has a designer price, so a partial sum is never set against the whole bundle */
          get designerTotal() {
            var map = this.designers;
            var all = this.picks.length > 0 && this.picks.every(function (vid) { return (map[vid] || 0) > 0; });
            return all ? this.picks.reduce(function (sum, vid) { return sum + map[vid]; }, 0) : 0;
          },
          get regularTotal() {
            var v = this.bundleVariant;
            return v ? Number(v.compare) || 0 : 0;
          },
          get saveTotal() {
            var v = this.bundleVariant;
            return v ? Math.max(0, this.regularTotal - (Number(v.price) || 0)) : 0;
          },
          get showSummary() { return this.cfg.mode !== 'per_line' && this.picks.length > 0 && !!this.bundleVariant; },
          get regularLabel() { return String(this.cfg.text.sumRegular || '').replace('[n]', this.picks.length); },
          get canAdd() {
            if (this.adding || this.picks.length === 0) return false;
            if (this.cfg.mode === 'per_line') return true;

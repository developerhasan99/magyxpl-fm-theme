            return 100;
          },
          get goalsMsg() {
            var esc = function (s) {
              return String(s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
            };
            var total = this.goalsTotal;
            var next = (this.cfg.goals || []).filter(function (g) { return total < g.cents; })[0];
            if (!next) return esc(this.cfg.text.goalsDone || '');
            return esc(this.cfg.text.goalsNext || '')
              .replace('[amount]', '<strong>' + esc(this.money(next.cents - total)) + '</strong>')
              .replace('[goal]', '<strong>' + esc(next.unlock || '') + '</strong>');

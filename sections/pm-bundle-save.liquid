          },

          /* Lines */
          toggleLine: function (i) { this.lineIndex = this.lineIndex === i ? -1 : i; },
          lineOk: function (line) {
            if (this.lineIndex < 0) return true;
            var l = this.cfg.lines[this.lineIndex];
            return !l || (l.tag || '') === line;
          },
          lineCount: function (i) {
            var l = this.cfg.lines[i];
            if (!l) return 0;
            var tag = l.tag || '';
            return this.picks.filter(function (vid) { return this.rowLines[vid] === tag; }, this).length;
          },
          linePickedText: function (i) {
            return String(this.cfg.text.linePicked || '[n]').replace('[n]', this.lineCount(i));
          },
          get visibleRows() {
            if (this.qTokens.length) {
              return Object.keys(this.rowSearch).filter(function (vid) {
                return this.lineOk(this.rowLines[vid]) && this.searchOk(vid);
              }, this).length;
            }
            if (this.lineIndex < 0) return this.cfg.rowCount || 0;
            var l = this.cfg.lines[this.lineIndex];
            return l ? l.count : 0;
          },

          /* Rating link: smooth scroll to an on-page anchor (#reviews); other links navigate normally */
          scrollToAnchor: function (e) {
            var href = e.currentTarget.getAttribute('href') || '';
            if (href.charAt(0) !== '#') return;
            var target = document.getElementById(href.slice(1));
            if (!target) return;
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          },

          /* Search: brand / perfume / occasion. Accents folded (wieczór = wieczor), every word must match;
             longer words drop their Polish ending so 'randkę' finds 'Randka' and 'wieczorem' finds 'Wieczór'. */
          fold: function (s) {
            return String(s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/ł/g, 'l').replace(/[^a-z0-9]+/g, ' ').trim();
          },
          get qTokens() {
            var alias = { ysl: 'yves', jpg: 'gaultier', mfk: 'kurkdjian', dg: 'dolce', ck: 'calvin' };
            var words = this.fold(this.q).split(' ').filter(function (w) { return w.length > 0; });
            return words.map(function (w) {
              if (alias[w]) return alias[w];
              if (w.length >= 7) return w.slice(0, -2);
              if (w.length >= 5) return w.slice(0, -1);

{%- comment -%}
  Popular products (premium, restyled from the FM redesign; tryscent schema ids kept so existing templates
  keep their values): pm-title heading + "Zobacz wszystkie" link to the collection in one row, optional
  subheading, Swiper carousel of product cards (1.25 / 2.2 / 3 / 4 per view) with white circle arrows.
  Used on the homepage (disabled), collection.payday-page, product.christians-pdp and other templates.
  tryscent.eu does not load Swiper globally, so the section loads Swiper 11 itself (same CDN build as the
  PDP gallery). Styles: assets/pm-s-popular-products.css. Background colour setting is unused: the colour
  scheme sets the background.
{%- endcomment -%}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">
{{ 'pm-s-popular-products.css' | asset_url | stylesheet_tag }}
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
    {%- if section.settings.background_image != blank %}
    background-image: url('{{ section.settings.background_image | image_url: width: 1920 }}');
    background-size: cover;
    background-position: center;
    {%- endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign pp_collection = section.settings.collection
  assign pp_heading = section.settings.heading | strip
  assign pp_link_text = section.settings.show_all_button_text | strip
-%}

<div id="{{ section.id }}" class="pm-popular color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if pp_heading != blank or pp_link_text != blank -%}
      <div class="pm-popular__head">
        {%- if pp_heading != blank -%}
          <h2 class="pm-popular__title pm-title">{{ pp_heading | escape }}</h2>
        {%- endif -%}
        {%- if pp_link_text != blank and pp_collection != blank -%}
          <a href="{{ pp_collection.url }}" class="pm-btn pm-btn--link pm-popular__link">{{ pp_link_text | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <div class="pm-popular__desc pm-body-lg pm-muted"><p>{{ section.settings.subheading | escape }}</p></div>
    {%- endif -%}
    <div class="pm-popular__slider swiper" id="slider-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- for product in pp_collection.products limit: 8 -%}
          <div class="swiper-slide pm-popular__slide">
            {%- render 'product-card', product: product -%}
          </div>
        {%- endfor -%}
      </div>
      <div class="pm-popular__nav">
        <button type="button" class="swiper-button-prev pm-popular__arrow" aria-label="{{ 'premium.general.previous' | t }}"></button>
        <button type="button" class="swiper-button-next pm-popular__arrow" aria-label="{{ 'premium.general.next' | t }}"></button>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initPopular() {
      var el = document.getElementById('slider-{{ section.id }}');
      if (!el || el.swiper || typeof window.Swiper === 'undefined') return;
      new window.Swiper(el, {
        slidesPerView: 1.25,
        spaceBetween: 12,
        slidesOffsetBefore: 20,
        slidesOffsetAfter: 20,
        watchOverflow: true,
        navigation: {
          nextEl: el.querySelector('.swiper-button-next'),
          prevEl: el.querySelector('.swiper-button-prev')
        },
        breakpoints: {
          750: { slidesPerView: 2.2, spaceBetween: 20, slidesOffsetBefore: 0, slidesOffsetAfter: 0 },
          990: { slidesPerView: 3, spaceBetween: 20, slidesOffsetBefore: 0, slidesOffsetAfter: 0 },
          1200: { slidesPerView: 4, spaceBetween: 20, slidesOffsetBefore: 0, slidesOffsetAfter: 0 }
        }
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPopular);
    } else {
      initPopular();
    }
    window.addEventListener('load', initPopular);
    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail && event.detail.sectionId === '{{ section.id }}') initPopular();
    });
  })();
</script>

{% schema %}
  {
    "name": "Popular Products",
    "class": "popular-products",
    "settings": [
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-1"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "info": "Unused since the premium redesign; the colour scheme sets the background.",
        "default": "#ffffff"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background Image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Bestsellery"
      },
      {
        "type": "text",
        "id": "subheading",
        "label": "Subheading"
      },
      {
        "type": "collection",
        "id": "collection",
        "label": "Collection"
      },
      {
        "type": "text",
        "id": "show_all_button_text",
        "label": "Show Button Text",
        "info": "Text link to the collection, next to the heading.",
        "default": "Zobacz wszystkie"
      },
      {
        "type": "header",
        "content": "Section Padding"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Top",
        "info": "Mobile uses half of this value.",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Padding Bottom",
        "info": "Mobile uses half of this value.",
        "default": 36
      }
    ],
    "presets": [
      {
        "name": "Popular Products"
      }
    ]
  }
{% endschema %}

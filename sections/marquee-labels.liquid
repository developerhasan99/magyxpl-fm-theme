{%- comment -%}
  Premium redesign (WP-C2): USP ticker. 40px band in the chosen colour scheme, labels 12/16 500 uppercase,
  optional separator, pauses on hover and under reduced motion (pm-ticker in pm-base.css).
  The `style` setting is kept for schema compatibility with the FM theme; on this store both values render
  the premium ticker (there is no legacy green band here).
{%- endcomment -%}
{%- liquid
  assign ticker_speed = section.settings.speed | default: 24
  assign ticker_sep = section.settings.separator
-%}
{{ 'pm-s-marquee-labels.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .premium .pm-ticker--{{ section.id }} {
    --pm-ticker-dur: {{ ticker_speed }}s;
  }
{%- endstyle -%}
<div class="pm-ticker pm-ticker--{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="pm-ticker__track">
    {%- for copy in (1..2) -%}
      <div class="pm-ticker__group"{% if copy == 2 %} aria-hidden="true"{% endif %}>
        {%- for repeat in (1..3) -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="pm-ticker__item"{% if copy == 2 or repeat > 1 %} tabindex="-1"{% endif %} {{ block.shopify_attributes }}>
            {%- else -%}
              <span class="pm-ticker__item" {{ block.shopify_attributes }}>
            {%- endif -%}
              {%- if block.settings.icon -%}
                <img
                  src="{{ block.settings.icon | image_url: height: 32, width: 32 }}"
                  alt=""
                  height="32"
                  width="32"
                  loading="lazy">
              {%- endif -%}
              <span>{{ block.settings.label }}</span>
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
            {%- if ticker_sep != blank -%}
              <span class="pm-ticker__sep" aria-hidden="true">{{ ticker_sep }}</span>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
  {
    "name": "Marquee Labels",
    "settings": [
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "info": "Both options render the premium ticker on this theme.",
        "options": [
          { "value": "legacy", "label": "Legacy" },
          { "value": "premium", "label": "Premium ticker" }
        ],
        "default": "premium"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "Color scheme",
        "default": "scheme-3"
      },
      {
        "type": "range",
        "id": "speed",
        "label": "Loop duration",
        "min": 8,
        "max": 60,
        "step": 2,
        "unit": "s",
        "default": 24
      },
      {
        "type": "text",
        "id": "separator",
        "label": "Separator between labels",
        "default": "•"
      }
    ],
    "blocks": [
      {
        "type": "label",
        "name": "Label",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label",
            "default": "60-dniowa gwarancja zwrotu pieniędzy"
          },
          {
            "type": "url",
            "id": "link",
            "label": "Link"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Marquee Labels",
        "blocks": [
          {
            "type": "label",
            "settings": {
              "label": "Wyprodukowano w Europie"
            }
          },
          {
            "type": "label",
            "settings": {
              "label": "20% olejku perfumeryjnego z Grasse"
            }
          },
          {
            "type": "label",
            "settings": {
              "label": "Bez ftalanów i parabenów"
            }
          },
          {
            "type": "label",
            "settings": {
              "label": "60-dniowa gwarancja zwrotu pieniędzy"
            }
          },
          {
            "type": "label",
            "settings": {
              "label": "Dostawa w 1-3 dni robocze"
            }
          }
        ]
      }
    ]
  }
{% endschema %}

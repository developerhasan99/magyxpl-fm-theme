<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: 0px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  {%- comment -%}
    Port of Federico Mahora's main-product (1:1 pass, 30.10.2026). Store adaptations: Polish copy, product titles
    through polish-store-text, rating line from pm-review-stats (theme-owned reviews), designer from the
    custom.inspired_by metaobject (blurred bottle, as everywhere on tryscent.eu). Block types FM does not have
    (short_description, custom_offer_bundle, ugc_videos, featured_bundle, reactive_atc, blocky-*) stay at the end of
    the block loop because other product templates still use them.
  {%- endcomment -%}
  {%- liquid
    # Editorial layout (WP-C1): full-bleed gallery stack + sticky buy box. Classic keeps Dawn's page-width layout.
    assign pm_editorial = false
    if section.settings.layout == 'editorial'
      assign pm_editorial = true
    endif
  -%}
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if pm_editorial -%}
    <script src="{{ 'pm-pdp.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="{% if pm_editorial %}pm-pdp{% else %}page-width{% endif %}">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper{% unless pm_editorial %} pb-6{% endunless %}">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {% when 'inspired_by' %}
                {%- assign pm_insp = product.metafields.custom.inspired_by.value -%}
                {%- if pm_insp != blank and pm_insp.name != blank -%}
                  {%- assign pm_inspiration_name = pm_insp.name -%}
                  {%- if pm_editorial -%}
                    {%- assign pm_designer_img = pm_insp.image.value -%}
                    {%- if pm_designer_img != blank -%}
                      {%- comment -%} Designer bottle (custom.inspired_by -> inspiration metaobject) next to the name; blurred on tryscent.eu {%- endcomment -%}
                      {%- assign pm_insp_label = block.settings.label | default: '' | strip -%}
                      {%- if pm_insp_label == blank -%}
                        {%- assign pm_insp_label = 'bundle.inspired_by' | t -%}
                      {%- endif -%}
                      <div class="pm-inspired" {{ block.shopify_attributes }}>
                        <span class="pm-inspired__media">
                          {{ pm_designer_img | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'eager', alt: pm_inspiration_name, class: 'pm-inspired__img pm-inspired__img--blur' }}
                        </span>
                        <span class="pm-inspired__text">
                          <span class="pm-inspired__label">{{ pm_insp_label | escape }}</span>
                          <span class="pm-inspired__name">{{ pm_inspiration_name }}</span>
                          {%- assign pm_retail = product.metafields.custom.original_retail_price.value -%}
                          {%- if block.settings.show_retail_price != false and pm_retail != blank -%}
                            {%- assign pm_retail_label = block.settings.retail_label | default: '' | strip -%}
                            {%- if pm_retail_label == blank -%}
                              {%- assign pm_retail_label = 'sections.pre_atc_blocks.original_retail_price_label' | t -%}
                            {%- endif -%}
                            {%- comment -%} Converted to the shop currency (cents), then up to the next ,99 (484,36 -> 484,99) {%- endcomment -%}
                            {%- assign pm_retail_cents = pm_retail | times: 1 | plus: 99 | divided_by: 100 | times: 100 | minus: 1 -%}
                            <span class="pm-inspired__retail">{{ pm_retail_label | escape }}: {{ pm_retail_cents | money }}</span>
                          {%- endif -%}
                        </span>
                      </div>
                    {%- else -%}
                      <p class="pm-subtitle" {{ block.shopify_attributes }}>{{ 'premium.card.inspired_by' | t: name: pm_inspiration_name }}</p>
                    {%- endif -%}
                  {%- else -%}
                    <p class="text-base tracking-normal leading-snug my-0 line-clamp-1 text-gray-500">{{ 'premium.card.inspired_by' | t: name: pm_inspiration_name }}</p>
                  {%- endif -%}
                {%- endif -%}
              {% when 'scent_intensity' %}
                {% if product.metafields.custom.scent_intensity != blank %}
                  <div class="flex items-center gap-[5px]">
                    Intensywność zapachu: <span class="text-highlight leading-4">Wyrazista</span>
                    {% assign intensity = product.metafields.custom.scent_intensity.value | times: 1 %}
                    <div class="flex gap-[5px] items-center justify-center ml-1">
                        {% for i in (1..3) %}
                          <div class="w-[8px] h-[8px] rounded-full {% if i <= intensity %}bg-black{% else %}bg-gray-300{% endif %} !inline-block"></div>
                        {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% when 'made_in_the_eu' %}
                <div {{ block.shopify_attributes }}>
                  <div class="inline-flex items-center gap-2 px-2 py-1 rounded-full bg-gray-100 font-semibold">
                    <img src="https://upload.wikimedia.org/wikipedia/commons/b/b7/Flag_of_Europe.svg" alt=""height="20" width="20" class="object-cover size-5 rounded-full"> <span>Bez szkodliwej chemii</span>
                  </div>
                </div>
              {%- when 'social_proof_review' -%}
                <div class="flex items-center gap-2" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <img
                      src="{{ block.settings.image | image_url: width: 64 }}"
                      alt="{{ block.settings.author_name | escape }}"
                      width=""
                      height=""
                      loading="lazy"
                      class="rounded-full object-cover flex-shrink-0 h-6 w-auto"
                    >
                  {%- endif -%}
                  <p class="text-sm text-gray-800 leading-snug m-0 flex items-center gap-1">
                    <span class="font-bold">{{ block.settings.author_name }}</span>
                    {%- render 'pm-stars', rating: 5, size: 14 -%}
                    {{ block.settings.review_text }}
                  </p>
                </div>
              {% when 'designer_price' %}
                {% if product.metafields.custom.original_retail_price != blank %}
                  <div>(Cena markowa: {{ product.metafields.custom.original_retail_price.value | money_without_trailing_zeros }})</div>
                {% endif %}
              {% when 'cheaper_than' %}
                <div>
                  {% assign alternate_product = product.metafields.custom['18_25_alternative_product'].value %}
                  {% if alternate_product != blank %}
                    <h3 class="!mb-3"><strong>Stężenie</strong> (wybierz koncentrację)</h3>
                    <div class="flex gap-3">
                      {%  if product.tags contains '25_edp' %}
                        <a href="{{ alternate_product.url }}" class="flex-1 border-2 border-solid border-gray-100 rounded-xl p-3 pt-4 bg-white no-underline transition-all">
                          <h3 class="my-0 text-black font-bold text-xl">18% EDP</h3>
                          <p class="my-0 text-gray-700 text-sm">Trwałość 4-8 godzin</p>
                        </a>
                        <div class="flex-1 border-2 border-solid border-black rounded-xl p-3 pt-4 bg-gray-100 relative">
                          <span class="absolute top-0 right-0 bg-black text-white text-xs font-semibold px-3 py-[2px] uppercase rounded-tr-lg rounded-bl-lg">
                            {{ 'premium.pdp.best_value' | t }}
                          </span>
                          <h3 class="my-0 text-black font-bold text-xl">25% EDP</h3>
                          <p class="my-0 text-gray-700 text-sm">Trwałość ponad 12 godzin</p>
                        </div>
                      {%  else %} 
                        <div class="flex-1 border-2 border-solid border-black cursor-not-allowed rounded-xl p-3 pt-4 bg-white no-underline">
                          <h3 class="my-0 text-black font-bold text-xl">18% EDP</h3>
                          <p class="my-0 text-gray-700 text-sm">Trwałość 4-8 godzin</p>
                        </div>
                        <a href="{{ alternate_product.url }}" class="flex-1 border-2 border-solid border-gray-100 rounded-xl p-3 pt-4 bg-gray-100 relative no-underline transition-all">
                          <span class="absolute top-0 right-0 bg-black text-white text-xs font-semibold px-3 py-[2px] uppercase rounded-tr-lg rounded-bl-lg">
                            {{ 'premium.pdp.best_value' | t }}
                          </span>
                          <h3 class="my-0 text-black font-bold text-xl">25% EDP</h3>
                          <p class="my-0 text-gray-700 text-sm">Trwałość ponad 12 godzin</p>
                        </a>
                      {% endif %}
                    </div>
                    <div class="mt-2">
                      <strong>25% = najdłuższa trwałość</strong> (większość perfum ma 15-20%)
                    </div>
                  {% endif %}
                </div>
              {% when 'bundle_content' %}
                {% if product.metafields.custom.bundle_product_content != blank %}
                  {%- liquid
                    assign bc_target = blank
                    for b in section.blocks
                      if b.id == block.settings.description_block_id
                        assign bc_target = 'Details-' | append: b.id | append: '-' | append: section.id
                      endif
                    endfor
                  -%}
                  <div class="flex items-center gap-1 font-normal text-black leading-[normal]" {{ block.shopify_attributes }}>
                    <p class="cheaper_than_text pm-bcontent" style="font-size: 14px; line-height: normal;">
                      {{ product.metafields.custom.bundle_product_content }}
                      {%- if bc_target != blank and block.settings.link_label != blank %}
                        <a class="pm-bcontent__more" href="#{{ bc_target }}" data-mgx-sdesc-more>{{ block.settings.link_label | escape }}</a>
                      {%- endif -%}
                    </p>
                  </div>
                  {%- if bc_target != blank and block.settings.link_label != blank -%}
                    <script src="{{ 'mgx-sdesc.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                {% endif %}
              {% when 'bundle_price' %}
                {% if product.tags contains 'Bundle_Price_Show' %}
                  <div id="price-{{ section.id }}" class="bundle-price-pdp" role="status" {{ block.shopify_attributes }}>
                    <div class="flex flex-wrap items-center gap-x-3">
                      {% if product.compare_at_price > product.price %}
                        <span class="text-gray-500 font-semibold line-through text-base md:text-[19px]">
                          {{ product.compare_at_price | money }}
                        </span>
                      {% endif %}
                      <span class="text-black font-bold text-[23px] md:text-[27px]">
                        {{ product.price | money }}
                      </span>
                      {% if product.compare_at_price > product.price %}
                        {% assign discount = product.compare_at_price | minus: product.price %}
                        {% assign discount_percent = discount | times: 100 | divided_by: product.compare_at_price | round %}
                        <span class="bg-black text-white font-bold px-2 text-xs md:text-base">
                          -{{ discount_percent }}%
                        </span>
                      {% endif %}
                    </div>
                    {% assign price_per_bottle = product.price | divided_by: product.metafields.custom.choose_your_fragrances_options | money %}
                    <div class="text-lg font-semibold text-black leading-normal">
                      {{ 'bundle.price_per_bottle' | t: price: price_per_bottle }}
                    </div>
                    {%- if product.compare_at_price > product.price -%}
                      <div class="inline-flex items-center gap-1 mt-2 bg-gray-100 text-black font-bold text-sm rounded-full py-1 px-2 border border-solid border-gray-200"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2L4.5 13.5H11l-1 8.5L19.5 10H13z"></path></svg>Oszczędzasz dziś {{ product.compare_at_price | minus: product.price | money }}</div>
                    {%- endif -%}
                  </div>
                {% endif %}
              {%- when 'mobile_gallery' -%}
                <div class="md:hidden">
                  {% render 'product-mobile-media-gallery', variant_images: variant_images %}
                </div>
              {%- when 'reactive_variant_selector' -%}
                <div class="reactive-variant-selector">
                  {% render 'reactive-variant-selector', product: product %}
                </div>
              {%- when 'atc_bundle_builder' -%}
                <div class="atc-bundle-builder" {{ block.shopify_attributes }}>
                   {% if product.metafields.custom.choose_your_fragrances_options != blank %}
                    {% render 'bundle-builder', product: product, block: block %}
                  {% else %}
                    {% render 'reactive-variant-selector', product: product, section: section %}
                  {% endif %}
                </div>
              {% when 'bundle_builder_2' %}
                {% render 'bundle-builder' %}
              {%- when 'magic_perfume_atc' -%}
                {% render 'magic-perfume-atc' %}
              {%- when 'shipping_text' -%}
                <div class="!my-6">
                  <p class="my-0 text-center font-semibold tracking-normal">
                    Dostawa w 5-8 dni, kraj: <span class="shipping_location">{{ localization.country.name }}</span>
                  </p>
                  <p class="my-0 text-center tracking-normal shipping_text_canada">
                    *Koszt wysyłki obliczymy przy kasie
                  </p>
                </div>
              {%- when 'selling_points' -%}
                {%- if pm_editorial -%}
                  {%- comment -%}
                    Claim lines from the block settings (same three lines as magyx.co), then the short description
                    from the product field custom.short_description. The product's selling_points field is not used here.
                  {%- endcomment -%}
                  {%- capture pm_check -%}<svg class="pm-benefits__icon" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.6 11.4l2.9 2.9 5.9-5.9" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endcapture -%}
                  <div {{ block.shopify_attributes }}>
                    <ul class="pm-benefits">
                      {%- if block.settings.benefit_1 != blank -%}
                        <li class="pm-benefits__item">{{ pm_check }}<span>{{ block.settings.benefit_1 }}</span></li>
                      {%- endif -%}
                      {%- if block.settings.benefit_2 != blank -%}
                        <li class="pm-benefits__item">{{ pm_check }}<span>{{ block.settings.benefit_2 }}</span></li>
                      {%- endif -%}
                      {%- if block.settings.benefit_3 != blank -%}
                        <li class="pm-benefits__item">{{ pm_check }}<span>{{ block.settings.benefit_3 }}</span></li>
                      {%- endif -%}
                    </ul>
                    {%- assign pm_sdesc = product.metafields.custom.short_description.value | strip -%}
                    {%- if pm_sdesc != blank -%}
                      <p class="pm-sdesc">{{ pm_sdesc | escape | newline_to_br }}</p>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <ul class="list-none p-0">
                    {% for item in product.metafields.custom.selling_points.value %}
                      <li class="flex gap-2 items-center text-gray-950 mb-4 leading-[1.2]">
                        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="11" fill="currentColor"/><path d="M6.6 11.4l2.9 2.9 5.9-5.9" fill="none" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        {{ item }}
                      </li>
                    {% endfor %}
                  </ul>
                {%- endif -%}
              {%- when 'trust_row' -%}
                {%- capture pm_ship_location -%}{% render 'ships-from-location' %}{%- endcapture -%}
                {%- assign pm_ship_location = pm_ship_location | strip | split: ' ' | first -%}
                <div class="pm-trust" {{ block.shopify_attributes }}>
                  {%- if block.settings.shipping_text != blank -%}
                    <div class="pm-trust__item"><span class="pm-dot" aria-hidden="true"></span><span>{{ block.settings.shipping_text }}</span></div>
                  {%- elsif block.settings.show_shipping -%}
                    <div class="pm-trust__item"><span class="pm-dot" aria-hidden="true"></span><span>{{ 'premium.pdp.ships_next_day_html' | t: location: pm_ship_location }}</span></div>
                  {%- endif -%}
                  {%- if block.settings.guarantee_text != blank -%}
                    <div class="pm-trust__item">{% render 'pm-icon', icon: 'shield', size: 16, stroke: 1.5, class: 'pm-trust__icon' %}<span>{{ block.settings.guarantee_text }}</span></div>
                  {%- endif -%}
                </div>
              {%- when 'story_card' -%}
                {%- assign pm_story = product.metafields.custom.scent_description -%}
                {%- if pm_story != blank -%}
                  {%- assign pm_story_label = block.settings.heading -%}
                  {%- if pm_story_label == blank -%}
                    {%- assign pm_story_label = 'premium.pdp.the_scent' | t -%}
                  {%- endif -%}
                  <details class="pm-story" {{ block.shopify_attributes }}>
                    <summary class="pm-story__summary">
                      {%- if block.settings.background_image != blank -%}
                        <img
                          class="pm-story__bg"
                          src="{{ block.settings.background_image | image_url: width: 1200 }}"
                          alt=""
                          width="{{ block.settings.background_image.width }}"
                          height="{{ block.settings.background_image.height }}"
                          loading="lazy">
                      {%- endif -%}
                      <span class="pm-story__text">
                        <span class="pm-story__label">{{ pm_story_label }}</span>
                        <span class="pm-story__preview">{{ pm_story | strip_html | strip_newlines }}</span>
                      </span>
                      {% render 'pm-icon', icon: 'chevron-down', size: 16, stroke: 1.5, class: 'pm-story__chevron' %}
                    </summary>
                    <div class="pm-story__body">{{ pm_story | strip_html | newline_to_br }}</div>
                  </details>
                {%- endif -%}
              {%- when 'money_back' -%}
                <div class="my-6" {{ block.shopify_attributes }}>
                  <div class="flex items-center gap-3 text-base">
                    <img
                      src="https://cdn.shopify.com/s/files/1/0623/0691/0402/files/thimbs_up.png?v=1751372431"
                      alt="Kciuk w górę"
                      class="w-10 h-10 flex-shrink-0"
                      width="40"
                      height="40" />
                    <div class="text-slate-900">
                      <strong class="font-semibold">{{ block.settings.title }}</strong>
                      <span class="block">{{ block.settings.text }}</span>
                    </div>
                  </div>
                </div>
              {% when 'tsr_block' %}
                {% if block.settings.product != blank %}
                  <a href="{{ block.settings.product.url }}" class="!mb-6 flex items-stretch overflow-hidden rounded-xl border-2 border-black border-solid bg-white text-inherit no-underline shadow-[0_1px_2px_rgba(17,24,39,0.06)] transition-shadow hover:shadow-[0_2px_10px_rgba(17,24,39,0.08)]">
                    <div class="flex w-[46%] max-w-[260px] shrink-0 items-center bg-gray-100">
                      {%- liquid
                        assign tsr_localized_image_found = false
                        assign tsr_currency_alt = localization.country.iso_code | prepend: 'bundle_' | downcase
                      -%}
                      {%- for tsr_image in block.settings.product.images -%}
                        {%- assign tsr_img_alt = tsr_image.alt | downcase -%}
                        {%- if tsr_img_alt contains 'bundle_' and tsr_img_alt == tsr_currency_alt -%}
                          {%- assign tsr_localized_image_found = true -%}
                          <img
                            src="{{ tsr_image.src | image_url: width: 720 }}"
                            alt="{{ tsr_image.alt }}"
                            class="block h-auto w-full object-contain"
                            loading="lazy"
                            width="{{ tsr_image.width }}"
                            height="{{ tsr_image.height }}">
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if tsr_localized_image_found == false -%}
                        <img
                          src="{{ block.settings.product.featured_image | image_url: width: 720 }}"
                          alt="{{ block.settings.product.title | escape }}"
                          class="block h-auto w-full object-contain"
                          loading="lazy"
                          width="720"
                          height="720">
                      {%- endif -%}
                    </div>

                    <div class="flex min-w-0 flex-1 flex-col justify-center p-4 md:p-5">
                      {% if block.settings.product.compare_at_price > block.settings.product.price %}
                        {% assign discount = block.settings.product.compare_at_price | minus: block.settings.product.price %}
                        {% assign discount_percent = discount | times: 100 | divided_by: block.settings.product.compare_at_price | round %}
                        <span class="inline-block self-start rounded-full bg-gray-100 text-black px-2 py-0.5 text-xs font-semibold uppercase tracking-wide">
                          {{ 'bundle.tsr_offer_save' | t: percent: discount_percent }}
                        </span>
                      {% endif %}
                      <h3 class="mt-2 mb-1 tracking-normal font-semibold leading-snug text-slate-900 text-sm sm:text-base md:text-lg">
                        {{ 'bundle.tsr_offer_heading' | t }}
                      </h3>
                      <p class="m-0 tracking-normal text-slate-600 text-sm md:text-base">
                        {{ 'bundle.tsr_offer_price_prefix' | t }}
                        <strong class="text-slate-900">{{ block.settings.product.price | divided_by: block.settings.product.metafields.custom.choose_your_fragrances_options | money }}</strong>
                        {{ 'bundle.tsr_offer_price_suffix' | t }}
                      </p>
                    </div>
                  </a>
                {% endif %}
              {%- when 'afterpay' -%}
                <div id="afterpay" class="flex items-center gap-1.5 flex-wrap tracking-normal">
                  <span class="text-black">4 nieoprocentowane raty po <span id="afterpay_price">{{ product.price | divided_by: 4 | money }}</span> z Klarna</span>
                </div>
              {%- when 'selling_fast' -%}
                {% render 'selling-fast', block: block %}
              {% when 'people_purchased' %}
                <div class="grid grid-cols-3 items-center gap-4 bg-gray-100 p-6 rounded">
                  <div class="col-span-1 flex">
                    <img class="w-full h-auto" src="https://cdn.shopify.com/s/files/1/0086/7932/5753/files/people-images.png?v=1756736550" alt="" height="" width="">
                  </div>
                  <div class="col-span-2">
                    <p class="my-0 leading-snug tracking-normal">Ponad <strong>826</strong> osób z kraju <span class="shipping_location font-semibold">{{ localization.country.name }}</span> zamówiło w ciągu ostatnich 7 dni.</p>
                  </div>
                </div>
              {%- when 'cta_review' -%}
                <div class="pt-6 pb-2 border-0 border-t border-solid border-gray-200">
                  <div class="leading-snug tracking-normal italic [&_p]:!m-0 text-lg">
                    {{ product.metafields.custom.cta_review.value.content | metafield_tag }}
                  </div>
                  <h3 class="mb-0 mt-2 text-base font-semibold text-gray-500 tracking-normal">
                    {{ product.metafields.custom.cta_review.value.author }}
                    <span class="text-sm ml-2 inline-flex align-middle">{%- render 'pm-stars', rating: 5, size: 14 -%}</span>
                  </h3>
                </div>
              {%- when 'videos' -%}
                {% render 'cta-videos', block: block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext !my-6{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
              {%-  when 'custom_rating_text' -%}
                {%- if pm_editorial -%}
                  {%- liquid
                    # Eyebrow from the gender tags (German and Polish store tags, any case); hidden when the product has none
                    assign pm_gender = ''
                    for tag in product.tags
                      assign pm_tag_key = tag | downcase | remove: ' '
                      if pm_tag_key == 'fürmänner' or pm_tag_key == 'fuer-maenner' or pm_tag_key == 'dla-mezczyzn'
                        assign pm_gender = 'men'
                      elsif pm_tag_key == 'fürfrauen' or pm_tag_key == 'fuer-frauen' or pm_tag_key == 'dla-kobiet'
                        assign pm_gender = 'women'
                      elsif pm_tag_key == 'unisex' and pm_gender == ''
                        assign pm_gender = 'unisex'
                      endif
                    endfor
                    assign pm_eyebrow = ''
                    if pm_gender == 'men'
                      assign pm_eyebrow = 'premium.pdp.for_him' | t
                    elsif pm_gender == 'women'
                      assign pm_eyebrow = 'premium.pdp.for_her' | t
                    elsif pm_gender == 'unisex'
                      assign pm_eyebrow = 'premium.pdp.unisex' | t
                    endif
                  -%}
                  {%- comment -%} Stars + count from the theme review data (sections/pm-reviews): this product's numbers, else the store totals {%- endcomment -%}
                  {%- capture pm_rating_score -%}
                    {%- render 'pm-review-stats', product: product, mode: 'pdp' -%}
                  {%- endcapture -%}
                  {%- assign pm_rating_score = pm_rating_score | strip -%}
                  <div class="pm-rating" {{ block.shopify_attributes }}>
                    {%- if pm_eyebrow != blank -%}
                      <span class="pm-rating__eyebrow">{{ pm_eyebrow }}</span>
                    {%- endif -%}
                    {%- if pm_rating_score != '' -%}
                      {{ pm_rating_score }}
                    {%- elsif block.settings.text != blank -%}
                      <span class="pm-rating__score">
                        {%- render 'pm-stars', rating: block.settings.rating, size: 14 -%}
                        <a class="pm-rating__link" href="#reviews">{{ block.settings.text }}</a>
                      </span>
                    {%- endif -%}
                  </div>
                {%- else -%}
                  <a href="#reviews" class="flex gap-1 items-center no-underline" {{ block.shopify_attributes }}>
                    <img src="{{ 'rating-stars.svg' |  asset_url }}" alt="*****" height="16" width="80">
                    <div class="leading-snug tracking-normal">
                      {{ block.settings.text }}
                    </div>
                  </a>
                {%- endif -%}
              {%- when 'title' -%}
                {%- liquid
                  assign pm_is_best = false
                  for tag in product.tags
                    assign pm_tag_key = tag | downcase
                    if pm_tag_key == 'bestseller'
                      assign pm_is_best = true
                      break
                    endif
                  endfor
                  assign discount_percent = 0
                  if product.tags contains 'onsale' and product.compare_at_price > product.price
                    assign discount_percent = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round
                  endif
                -%}
                {%- if pm_editorial -%}
                <div class="product__title pm-titlebox" {{ block.shopify_attributes }}>
                  {%- if pm_is_best or product.tags contains 'onsale' -%}
                    <div class="pm-badges">
                      {%- if product.tags contains 'onsale' -%}
                        <span class="pm-badge pm-badge--ink">{% if discount_percent > 0 %}-{{ discount_percent }}%{% else %}{{ 'premium.card.sale' | t }}{% endif %}</span>
                      {%- endif -%}
                      {%- if pm_is_best -%}
                        <span class="pm-badge pm-badge--outline">{{ 'premium.card.bestseller' | t }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <h1 class="pm-h1">{% render 'polish-store-text', text: product.title %}</h1>
                </div>
                {%- else -%}
                <div class="product__title relative" {{ block.shopify_attributes }}>
                  {%- if pm_is_best or product.tags contains 'onsale' -%}
                    <div class="absolute top-0 left-0">
                      {% if product.tags contains 'onsale' %}
                        <span class="inline-block bg-black text-white text-sm font-bold px-3 py-1">
                          {{ discount_percent }}% rabatu
                        </span>
                      {% endif %}
                      {% if pm_is_best %}
                        <span class="inline-block bg-black text-white text-sm font-bold px-3 py-1">
                          {{ 'premium.card.bestseller' | t }}
                        </span>
                      {% endif %}
                    </div>
                  {%- endif -%}
                  <h1 class="font-[700] leading-tight !tracking-normal text-3xl {% if pm_is_best or product.tags contains 'onsale' %}pt-8{% endif %}">
                    {% render 'polish-store-text', text: product.title %}
                  </h1>
                </div>
                {%- endif -%}
              {%- when 'price' -%}
                <div id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price',
                    product: product,
                    use_variant: true,
                    show_badges: true,
                    price_class: 'price--large',
                    show_compare_at_price: true
                  -%}
                </div>
                {%- if product.quantity_price_breaks_configured? -%}
                  <div class="volume-pricing-note" id="Volume-Note-{{ section.id }}">
                    <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                  </div>
                {%- endif -%}
                {%- if cart.taxes_included or cart.duties_included or shop.shipping_policy.body != blank -%}
                  <div class="product__tax caption rte">
                    {%- if cart.duties_included and cart.taxes_included -%}
                      {{ 'products.product.duties_and_taxes_included' | t }}
                    {%- elsif cart.taxes_included -%}
                      {{ 'products.product.taxes_included' | t }}
                    {%- elsif cart.duties_included -%}
                      {{ 'products.product.duties_included' | t }}
                    {%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </div>
                {%- endif -%}
                <div {{ block.shopify_attributes }}>
                  {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                  {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                    {{ form | payment_terms }}
                  {%- endform -%}
                </div>
              {%- when 'inventory' -%}
                <p
                  class="product__inventory{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                  {{ block.shopify_attributes }}
                  id="Inventory-{{ section.id }}"
                  role="status"
                >
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      {%- if product.selected_or_first_available_variant.inventory_quantity
                          <= block.settings.inventory_threshold
                      -%}
                        <span class="svg-wrapper" style="color: rgb(238, 148, 65)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_low_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_low_stock' | t -}}
                        {%- endif -%}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {%- if block.settings.show_inventory_quantity -%}
                          {{-
                            'products.product.inventory_in_stock_show_count'
                            | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                          -}}
                        {%- else -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                        <span class="svg-wrapper" style="color: rgb(62, 214, 96)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                      {%- else -%}
                        <span class="svg-wrapper" style="color: rgb(200, 200, 200)">
                          {{- 'icon-inventory-status.svg' | inline_asset_content -}}
                        </span>
                        {{- 'products.product.inventory_out_of_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endif -%}
                </p>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'sku' -%}
                <p
                  class="product__sku{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.sku.size == 0 %} visibility-hidden{% endif %}"
                  id="Sku-{{ section.id }}"
                  role="status"
                  {{ block.shopify_attributes }}
                >
                  <span class="visually-hidden">{{ 'products.product.sku' | t }}:</span>
                  {{- product.selected_or_first_available_variant.sku -}}
                </p>
              {%- when 'custom_liquid' -%}
                {{ block.settings.custom_liquid }}
              {%- when 'quantity_selector' -%}
                <div
                  id="Quantity-Form-{{ section.id }}"
                  class="product-form__input product-form__quantity{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} product-form__quantity-top{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% comment %} TODO: enable theme-check once `item_count_for_variant` is accepted as valid filter {% endcomment %}
                  {% # theme-check-disable %}
                  {%- assign cart_qty = cart
                    | item_count_for_variant: product.selected_or_first_available_variant.id
                  -%}
                  {% # theme-check-enable %}
                  <label class="quantity__label form__label visibility-hidden h-0 overflow-hidden m-0" for="Quantity-{{ section.id }}">
                    {{ 'products.product.quantity.label' | t }}
                    <span class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %}">
                      {%- render 'loading-spinner' -%}
                      <span
                        >(
                        {{- 'products.product.quantity.in_cart_html' | t: quantity: cart_qty -}}
                        )</span
                      >
                    </span>
                  </label>
                  <div class="price-per-item__container">
                    <quantity-input class="bg-white p-1.5 rounded-full flex shadow" data-url="{{ product.url }}" data-section="{{ section.id }}">
                      <button class="quantity__button !bg-black size-10 rounded-full" name="minus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
                        </span>
                        <span class="svg-wrapper text-white !w-5">
                          {{- 'icon-minus.svg' | inline_asset_content -}}
                        </span>
                      </button>
                      <input
                        class="quantity__input focus:outline-none focus-visible:outline-none focus:shadow-none shadow-none focus:bg-transparent text-lg font-semibold text-black"
                        type="number"
                        name="quantity"
                        id="Quantity-{{ section.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button class="quantity__button !bg-black size-10 rounded-full" name="plus" type="button">
                        <span class="visually-hidden">
                          {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
                        </span>
                        <span class="svg-wrapper text-white !w-5">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </span>
                      </button>
                    </quantity-input>
                    {%- liquid
                      assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                      if cart_qty > 0
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                      endif
                    -%}
                    {%- if product.quantity_price_breaks_configured? -%}
                      <price-per-item
                        id="Price-Per-Item-{{ section.id }}"
                        data-section-id="{{ section.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </dt>
                                <dd>
                                  <s class="variant-item__old-price">
                                    {{ variant_price_compare | money_with_currency }}
                                  </s>
                                </dd>
                              </dl>
                            {%- endif -%}
                            {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                              {%- assign variant_price = product.selected_or_first_available_variant.price
                                | money_with_currency
                              -%}
                              <span class="price-per-item--current">
                                {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                              </span>
                            {%- else -%}
                              {%- for price_break in volume_pricing_array -%}
                                {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                  {%- assign price_break_price = price_break.price | money_with_currency -%}
                                  <span class="price-per-item--current">
                                    {{-
                                      'products.product.volume_pricing.price_at_each_html'
                                      | t: price: price_break_price
                                    -}}
                                  </span>
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                            {%- endif -%}
                          </div>
                        {%- else -%}
                          {%- assign variant_price = product.selected_or_first_available_variant.price
                            | money_with_currency
                          -%}
                          {%- assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price -%}
                          <div class="price-per-item">
                            {%- if variant_price_compare -%}
                              <dl class="price-per-item--current">
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.regular_price' | t }}
                                </dt>
                                <dd>
                                  <s class="variant-item__old-price">
                                    {{ variant_price_compare | money_with_currency }}
                                  </s>
                                </dd>
                                <dt class="visually-hidden">
                                  {{ 'products.product.price.sale_price' | t }}
                                </dt>
                                <dd>
                                  <span class="price-per-item--current">
                                    {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                                  </span>
                                </dd>
                              </dl>
                            {%- else -%}
                              <span class="price-per-item--current">
                                {{- 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price -}}
                              </span>
                            {%- endif -%}
                          </div>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>
                  <div class="quantity__rules caption" id="Quantity-Rules-{{ section.id }}">
                    {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.multiples_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment
                        -}}
                      </span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.minimum_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.min
                        -}}
                      </span>
                    {%- endif -%}
                    {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                      <span class="divider">
                        {{-
                          'products.product.quantity.maximum_of'
                          | t: quantity: product.selected_or_first_available_variant.quantity_rule.max
                        -}}
                      </span>
                    {%- endif -%}
                  </div>
                  {%- if product.quantity_price_breaks_configured? -%}
                    <volume-pricing class="parent-display" id="Volume-{{ section.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                        <span class="caption-large">{{ 'products.product.volume_pricing.title' | t }}</span>
                        <ul class="list-unstyled">
                          <li>
                            <span>{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                            {%- assign price = product.selected_or_first_available_variant.price
                              | money_with_currency
                            -%}
                            <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: variant_price }}">
                              {{- 'sections.quick_order_list.each' | t: money: price -}}
                            </span>
                          </li>
                          {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                            {%- assign price_break_price = price_break.price | money_with_currency -%}
                            <li class="{%- if forloop.index >= 3 -%}show-more-item hidden{%- endif -%}">
                              <span>
                                {{- price_break.minimum_quantity -}}
                                <span aria-hidden="true">+</span></span
                              >
                              <span data-text="{{ 'products.product.volume_pricing.price_at_each_html' | t: price: price_break_price }}">
                                {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                              </span>
                            </li>
                          {%- endfor -%}
                        </ul>
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                          <show-more-button>
                            <button
                              class="button-show-more link underlined-link"
                              id="Show-More-{{ section.id }}"
                              type="button"
                            >
                              <span class="label-show-more label-text"
                                ><span aria-hidden="true">+ </span>{{ 'products.facets.show_more' | t }}
                              </span>
                            </button>
                          </show-more-button>
                        {%- endif -%}
                      {%- endif -%}
                    </volume-pricing>
                  {%- endif -%}
                </div>
              {%- when 'popup' -%}
                <modal-opener
                  class="product-popup-modal__opener quick-add-hidden"
                  data-modal="#PopupModal-{{ block.id }}"
                  {{ block.shopify_attributes }}
                >
                  <button
                    id="ProductPopup-{{ block.id }}"
                    class="product-popup-modal__button link"
                    type="button"
                    aria-haspopup="dialog"
                  >
                    {{ block.settings.text | default: block.settings.page.title | escape }}
                  </button>
                </modal-opener>
              {%- when 'share' -%}
                {% liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  render 'share-button', block: block, share_link: share_url
                %}

              {%- when 'variant_picker' -%}
                {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
              {%- when 'buy_buttons' -%}
               {%- render 'buy-buttons',
                  block: block,
                  product: product,
                  product_form_id: product_form_id,
                  section_id: section.id,
                  show_pickup_availability: true
                -%}
                
              {%- when 'rating' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="rating-wrapper">
                    {% liquid
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif
                    %}
                    <div
                      class="rating"
                      role="img"
                      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                    >
                      <span
                        aria-hidden="true"
                        class="rating-star"
                        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                      ></span>
                    </div>
                    <p class="rating-text caption">
                      <span aria-hidden="true">
                        {{- product.metafields.reviews.rating.value }} /
                        {{ product.metafields.reviews.rating.value.scale_max -}}
                      </span>
                    </p>
                    <p class="rating-count caption">
                      <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                      <span class="visually-hidden">
                        {{- product.metafields.reviews.rating_count }}
                        {{ 'accessibility.total_reviews' | t -}}
                      </span>
                    </p>
                  </div>
                {%- endif -%}
              {%- when 'complementary' -%}
                <product-recommendations
                  class="complementary-products quick-add-hidden{% if block.settings.make_collapsible_row %} is-accordion{% endif %}{% if block.settings.enable_quick_add %} complementary-products-contains-quick-add{% endif %}"
                  data-url="{{ routes.product_recommendations_url }}?limit={{ block.settings.product_list_limit }}&intent=complementary"
                  data-section-id="{{ section.id }}"
                  data-product-id="{{ product.id }}"
                >
                  {%- if recommendations.performed and recommendations.products_count > 0 -%}
                    <aside
                      aria-label="{{ 'accessibility.complementary_products' | t }}"
                      {{ block.shopify_attributes -}}
                      {% if block.settings.make_collapsible_row %}
                        class="product__accordion accordion"
                      {% endif %}
                    >
                      <div class="complementary-products__container">
                        {%- if block.settings.make_collapsible_row -%}
                          <details id="Details-{{ block.id }}-{{ section.id }}" open>
                            <summary>
                        {%- endif %}
                        <div class="summary__title">
                          {%- if block.settings.make_collapsible_row -%}
                            {% render 'icon-accordion', icon: block.settings.icon %}
                            <h2 class="h4 accordion__title">{{ block.settings.block_heading }}</h2>
                          {%- else -%}
                            <h2 class="h3 accordion__title">{{ block.settings.block_heading }}</h2>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.make_collapsible_row -%}
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                          </summary>
                        {%- endif -%}
                        <slideshow-component class="slider-mobile-gutter">
                          {%- assign number_of_slides = recommendations.products_count
                            | plus: 0.0
                            | divided_by: block.settings.products_per_page
                            | ceil
                          -%}
                          <div
                            id="Slider-{{ block.id }}"
                            class="contains-card contains-card--product complementary-slider grid grid--1-col slider slider--everywhere"
                            role="list"
                            {% if number_of_slides > 1 %}
                              aria-label="{{ 'general.slider.name' | t }}"
                            {% endif %}
                          >
                            {% assign skip_card_product_styles = false %}
                            {%- for i in (1..number_of_slides) -%}
                              <div
                                id="Slide-{{ block.id }}-{{ forloop.index }}"
                                class="complementary-slide complementary-slide--{{ settings.card_style }} grid__item slider__slide slideshow__slide"
                                tabindex="-1"
                                role="group"
                                {% if number_of_slides > 1 %}
                                  aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
                                  aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                {% endif %}
                              >
                                <ul class="list-unstyled" role="list">
                                  {%- for product in recommendations.products
                                    limit: block.settings.products_per_page
                                    offset: continue
                                  -%}
                                    <li>
                                      {%- if block.settings.enable_quick_add -%}
                                        {% assign quick_add = 'standard' %}
                                      {%- else -%}
                                        {% assign quick_add = 'none' %}
                                      {%- endif -%}
                                      {% render 'card-product',
                                        card_product: product,
                                        media_aspect_ratio: block.settings.image_ratio,
                                        show_secondary_image: false,
                                        lazy_load: false,
                                        skip_styles: skip_card_product_styles,
                                        quick_add: quick_add,
                                        section_id: section.id,
                                        horizontal_class: true,
                                        horizontal_quick_add: true
                                      %}
                                    </li>
                                    {%- assign skip_card_product_styles = true -%}
                                  {%- endfor -%}
                                </ul>
                              </div>
                            {%- endfor -%}
                          </div>
                          {%- if number_of_slides > 1 -%}
                            <div class="slider-buttons">
                              <button
                                type="button"
                                class="slider-button slider-button--prev"
                                name="previous"
                                aria-label="{{ 'general.slider.previous_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                              <div class="slider-counter slider-counter--{{ block.settings.pagination_style }}{% if block.settings.pagination_style == 'counter' or block.settings.pagination_style == 'numbers' %} caption{% endif %}">
                                {%- if block.settings.pagination_style == 'counter' -%}
                                  <span class="slider-counter--current">1</span>
                                  <span aria-hidden="true"> / </span>
                                  <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
                                  <span class="slider-counter--total">{{ number_of_slides }}</span>
                                {%- else -%}
                                  <div class="slideshow__control-wrapper">
                                    {%- for i in (1..number_of_slides) -%}
                                      <button
                                        class="slider-counter__link slider-counter__link--{{ block.settings.pagination_style }} link"
                                        aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
                                        aria-controls="Slider-{{ block.id }}"
                                      >
                                        {%- if block.settings.pagination_style == 'numbers' -%}
                                          {{ forloop.index -}}
                                        {%- else -%}
                                          <span class="dot"></span>
                                        {%- endif -%}
                                      </button>
                                    {%- endfor -%}
                                  </div>
                                {%- endif -%}
                              </div>
                              <button
                                type="button"
                                class="slider-button slider-button--next"
                                name="next"
                                aria-label="{{ 'general.slider.next_slide' | t }}"
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-caret.svg' | inline_asset_content -}}
                                </span>
                              </button>
                            </div>
                          {%- endif -%}
                        </slideshow-component>
                        {%- if block.settings.make_collapsible_row -%}
                          </details>
                        {%- endif -%}
                      </div>
                    </aside>
                  {%- endif -%}
                  {{ 'component-card.css' | asset_url | stylesheet_tag }}
                  {{ 'component-complementary-products.css' | asset_url | stylesheet_tag }}
                  {%- if block.settings.enable_quick_add -%}
                    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
                    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
                  {%- endif -%}
                </product-recommendations>
              {%- when 'icon-with-text' -%}
                {% render 'icon-with-text', block: block %}
              {% when 'dialect_notes' %}
                {% if product.metafields.custom.upper_notes.value != blank or product.metafields.custom.center_notes.value != blank or product.metafields.custom.deeper_notes.value != blank %}
                  <div class="space-y-4">
                    <h3 class="font-semibold text-lg">Jak pachnie:</h3>
                    {% if product.metafields.custom.upper_notes.value != blank %}
                      <div class="flex gap-3 flex-wrap">
                        <div class="flex gap-2 items-center">
                          <img
                            src="{{ 'top-notes.png' | asset_url }}"
                            alt="Nuty głowy"
                            width="24"
                            height="24">
                          <h3 class="font-semibold tracking-widest text-sm my-0">GŁOWA</h3>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                          {% for note in product.metafields.custom.upper_notes.value %}
                            <div class="bg-white rounded-full flex items-center gap-3 px-3 py-1">
                              <img
                                src="{{ note.icon | image_url: width: 64, height: 64 }}"
                                alt="{{ note.name }}"
                                width="24"
                                height="24"
                                loading="lazy">
                              <span>{{ note.name }}</span>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    {% if product.metafields.custom.center_notes.value != blank %}
                      <div class="flex gap-3 flex-wrap">
                        <div class="flex gap-2 items-center">
                          <img
                            src="{{ 'middle-notes.png' | asset_url }}"
                            alt="Nuty serca"
                            width="24"
                            height="24">
                          <h3 class="font-semibold tracking-widest text-sm my-0">SERCE</h3>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                          {% for note in product.metafields.custom.center_notes.value %}
                            <div class="bg-white rounded-full flex items-center gap-3 px-3 py-1">
                              <img
                                src="{{ note.icon | image_url: width: 64, height: 64 }}"
                                alt="{{ note.name }}"
                                width="24"
                                height="24"
                                loading="lazy">
                              <span>{{ note.name }}</span>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                    {% if product.metafields.custom.deeper_notes.value != blank %}
                        <div class="flex gap-3 flex-wrap">
                        <div class="flex gap-2 items-center">
                          <img
                            src="{{ 'base-notes.png' | asset_url }}"
                            alt="Nuty bazy"
                            width="24"
                            height="24">
                          <h3 class="font-semibold tracking-widest text-sm my-0">BAZA</h3>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                          {% for note in product.metafields.custom.deeper_notes.value %}
                            <div class="bg-white rounded-full flex items-center gap-3 px-3 py-1">
                              <img
                                src="{{ note.icon | image_url: width: 64, height: 64 }}"
                                alt="{{ note.name }}"
                                width="24"
                                height="24"
                                loading="lazy">
                              <span>{{ note.name }}</span>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endif %}
                  </div>
                {% endif %}
              {%- comment -%} tryscent.eu block types (not on FM); still used by other product templates {%- endcomment -%}
              {%- when 'short_description' -%}
                {%- comment -%} When the scent-profiling block gets the section, it shows the short description under the claim lines instead. A liquid setting reads back rendered, so look for the wrapper it outputs. {%- endcomment -%}
                {%- liquid
                  assign sdesc_in_profile = false
                  for b in section.blocks
                    if b.type == 'custom_liquid' and b.settings.custom_liquid contains 'mgx-sdesc-under-match'
                      assign sdesc_in_profile = true
                    endif
                  endfor
                -%}
                {%- unless sdesc_in_profile -%}
                  {% render 'short-description', block: block, section: section, product: product %}
                {%- endunless -%}
              {%- when 'custom_offer_bundle' -%}
                {%- liquid
                  assign cob_skip_head = false
                  for b in section.blocks
                    if b.type == 'bundle_price' or b.type == 'bundle_content'
                      assign cob_skip_head = true
                    endif
                  endfor
                -%}
                <div class="atc-bundle-builder" {{ block.shopify_attributes }}>
                  {% render 'custom-offer-bundle', block: block, skip_head: cob_skip_head %}
                </div>
              {%- when 'rating-app' -%}
                {%- if product.metafields.reviews.rating.value != blank -%}
                  <div class="rating-wrapper">
                    {% liquid
                      assign rating_decimal = 0
                      assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                      if decimal >= 0.3 and decimal <= 0.7
                        assign rating_decimal = 0.5
                      elsif decimal > 0.7
                        assign rating_decimal = 1
                      endif
                    %}
                    <div
                      class="rating"
                      role="img"
                      aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                    >
                      <span
                        aria-hidden="true"
                        class="rating-star"
                        style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                      ></span>
                    </div>
                    <p class="rating-text caption">
                      <span aria-hidden="true">
                        {{- product.metafields.reviews.rating.value }} /
                        {{ product.metafields.reviews.rating.value.scale_max -}}
                      </span>
                    </p>
                    <p class="rating-count caption">
                      <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                      <span class="visually-hidden">
                        {{- product.metafields.reviews.rating_count }}
                        {{ 'accessibility.total_reviews' | t -}}
                      </span>
                    </p>
                  </div>
                {%- endif -%}
              {%- when 'product_reviews' -%}
                {{ 'blocky-lys-product-reviews.css' | asset_url | stylesheet_tag }}
                {% render 'blocky-lys-product-reviews', block: block, side: 'right' %}
              {%- when 'review-stars' -%}
                {% render 'blocky-lys-review-stars', block: block %}
              {%- when 'shipping-checkpoints' -%}
                {% render 'blocky-lys-shipping-checkpoints', block: block %}
              {%- when 'payment_badges' -%}
                <div class="list-payment" {{ block.shopify_attributes }}>
                  {%- render 'payment-icons', item_tag: 'div' -%}
                </div>
              {%- when 'delivery_deadline' -%}
                <div
                  class="blocky blocky-text-{{ block.settings.text_alignment }} blocky-flex-{{ block.settings.text_layout }}"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.date_text != blank %}
                    {% capture date_format %}
                      {{ block.settings.date_format | replace: "day", block.settings.day_label | replace: "month", block.settings.month_label }}
                    {% endcapture %}
                    {% assign start_date_seconds = block.settings.days | times: 86400 %}
                    {% assign start_date = 'now' | date: '%s' | plus: start_date_seconds | date: date_format | strip %}
                    <p style="color: {{ block.settings.date_color }}; line-height: 1.2; font-size:{{ block.settings.date_size }}px;">
                      {{ block.settings.date_text | replace: '[DATE]', start_date }}
                    </p>
                  {% endif %}
                  {% if block.settings.timer_text != blank %}
                    <blocky-timer
                      data-text="{{ block.settings.timer_text }}"
                      data-hours="{{ block.settings.hours }}"
                      data-minutes="{{ block.settings.minutes }}"
                    >
                      <span
                        class="blocky-timer-text"
                        style="color: {{ block.settings.timer_color }}; line-height: 1.2; font-size:{{ block.settings.timer_size }}px;"
                      >
                        {{
                          block.settings.timer_text
                          | replace: '[HOURS]', block.settings.hours
                          | replace: '[MINUTES]', block.settings.minutes
                        }}
                      </span>
                    </blocky-timer>
                  {% endif %}
                </div>
              {%- when 'scroll_to' -%}
                <blocky-scroll-to
                  class="blocky blocky-scroll-to"
                  {{ block.shopify_attributes }}
                  style="--heading-text-color: {{ block.settings.heading_text_color }}; --btn-background-color: {{ block.settings.btn_background_color }}; --btn-text-color: {{ block.settings.btn_text_color }}; --btn-border-radius: {{ block.settings.btn_border_radius }}px; --heading-font-size: {{ block.settings.heading_font_size }}px;"
                >
                  <div class="blocky-scroll-to-heading">{{ block.settings.heading }}</div>
                  <div class="blocky-scroll-to-btns">
                    {% unless block.settings.button_1 == blank %}
                      <div class="blocky-scroll-to-btn" data-btn="1">{{ block.settings.button_1 }}</div>
                    {% endunless %}
                    {% unless block.settings.button_2 == blank %}
                      <div class="blocky-scroll-to-btn" data-btn="2">{{ block.settings.button_2 }}</div>
                    {% endunless %}
                    {% unless block.settings.button_3 == blank %}
                      <div class="blocky-scroll-to-btn" data-btn="3">{{ block.settings.button_3 }}</div>
                    {% endunless %}
                    {% unless block.settings.button_4 == blank %}
                      <div class="blocky-scroll-to-btn" data-btn="4">{{ block.settings.button_4 }}</div>
                    {% endunless %}
                  </div>
                </blocky-scroll-to>
              {%- when 'alert_text' -%}
                <div class="alert-text">
                  <style>
                    .alert-text-indicator {
                      display: flex;
                      align-items: center;
                    }

                    .alert-text-dot {
                      display: inline-block;
                      border-radius: 50%;
                      margin-right: 8px;
                      background-color: {{ block.settings.dot_color }};
                      width: {{ block.settings.dot_size }}px;
                      height: {{ block.settings.dot_size }}px;
                      {% if block.settings.animation == 'pulse' %}
                        animation: pulse 2s infinite;
                      {% elsif block.settings.animation == 'fade' %}
                        animation: fade 2s infinite;
                      {% elsif block.settings.animation == 'blink' %}
                        animation: blink 1s infinite;
                      {% endif %}
                    }

                    .alert-text-text {
                      color: {{ block.settings.text_color }};
                      font-size: {{ block.settings.font_size }}px;
                      {% if block.settings.is_bold %}
                        font-weight: 700;
                      {% else %}
                        font-weight: 400;
                      {% endif %}
                    }

                    @keyframes pulse {
                      0% {
                        transform: scale(1);
                        opacity: 1;
                      }
                      50% {
                        transform: scale(1.2);
                        opacity: 0.7;
                      }
                      100% {
                        transform: scale(1);
                        opacity: 1;
                      }
                    }

                    @keyframes fade {
                      0% {
                        opacity: 1;
                      }
                      50% {
                        opacity: 0.5;
                      }
                      100% {
                        opacity: 1;
                      }
                    }

                    @keyframes blink {
                      0% {
                        opacity: 1;
                      }
                      50% {
                        opacity: 0;
                      }
                      100% {
                        opacity: 1;
                      }
                    }
                  </style>
                  <div class="alert-text-indicator">
                    <span class="alert-text-dot"></span>
                    <span class="alert-text-text">{{ block.settings.text }}</span>
                  </div>
                </div>
                {% when 'reactive_atc' %}
                  {% render 'reactive-atc' %}
                {%- when 'featured_bundle' -%}
                  {%- comment -%}
                    The UGC video row can stand in for this card: its clips link
                    the same bundle. The card steps aside only once the row has
                    a clip and its "Ukryj Polecany zestaw" box is ticked, so the
                    page is never left with neither.
                  {%- endcomment -%}
                  {%- liquid
                    assign ugc_replaces_bundle = false
                    for ugc_block in section.blocks
                      if ugc_block.type == 'ugc_videos' and ugc_block.settings.replace_bundle
                        capture ugc_count
                          render 'ugc-video-count', block: ugc_block
                        endcapture
                        assign ugc_count = ugc_count | strip | plus: 0
                        if ugc_count > 0
                          assign ugc_replaces_bundle = true
                        endif
                      endif
                    endfor
                  -%}
                  {%- if ugc_replaces_bundle -%}
                    {%- if request.design_mode -%}
                      <div class="featured-bundle__placeholder quick-add-hidden mgx-text-muted" style="padding: 12px; border: 2px dashed var(--mgx-silver); border-radius: 12px; font-size: 13px; line-height: 1.4;" {{ block.shopify_attributes }}>
                        Polecany zestaw jest ukryty, bo blok Wideo UGC ma klipy i zaznaczone pole „Ukryj kartę Polecany zestaw”. Odznacz je, żeby karta wróciła.
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    {% render 'featured-bundle', block: block %}
                  {%- endif -%}
                {%- when 'ugc_videos' -%}
                  {% render 'ugc-video-row', block: block %}
            {%- endcase -%}
          {%- endfor -%}
          <div{% if pm_editorial %} class="pm-accordion"{% endif %}>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {% when 'expanded_notes' %}
                  {% render 'expanded-notes', premium: pm_editorial %}
                {%- when 'collapsible_tab' -%}
                  {%- if pm_editorial -%}
                  <details id="Details-{{ block.id }}-{{ section.id }}" class="pm-accordion__item quick-add-hidden" {{ block.shopify_attributes }}>
                    <summary aria-controls="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      <h2 class="pm-accordion__title">{{ block.settings.heading | default: block.settings.page.title | escape }}</h2>
                    </summary>
                    <div class="pm-accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                      {{ block.settings.content }}
                      {{ block.settings.page.content }}
                    </div>
                  </details>
                  {%- else -%}
                  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
                    <details id="Details-{{ block.id }}-{{ section.id }}">
                      <summary>
                        <div class="summary__title">
                          {% render 'icon-accordion'
                            , icon: block.settings.icon %}
                          <h2 class="h4 accordion__title inline-richtext font-bold tracking-normal text-sm md:text-base">
                            {{ block.settings.heading | default: block.settings.page.title | escape }}
                          </h2>
                        </div>
                        <div class="svg-wrapper bg-black text-white !size-6 p-1 rounded-full !mr-0 flex items-center justify-center">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </div>
                      </summary>
                      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                        {{ block.settings.content }}
                        {{ block.settings.page.content }}
                      </div>
                    </details>
                  </div>
                  {%- endif -%}
                {%- when 'product_statistics' -%}
                  {% render 'product-statistics', block: block %}
                {%- when 'press_quotes' -%}
                  {% render 'press-quotes', block: block %}
                {%- when 'review_slider' -%}
                  {% render 'review-slider', block: block %}
                {%- when 'sample_upsell' -%}
                  {% render 'sample-upsell', block: block %}
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <a href="{{ product.url }}" class="link product__view-details animate-arrow">
            {{ 'products.product.view_full_details' | t }}
            {{- 'icon-arrow.svg' | inline_asset_content -}}
          </a>
        </section>
      </div>
    </div>

    {% render 'product-media-modal', variant_images: variant_images %}

    {% assign popups = section.blocks | where: 'type', 'popup' %}
    {%- for block in popups -%}
      <modal-dialog id="PopupModal-{{ block.id }}" class="product-popup-modal" {{ block.shopify_attributes }}>
        <div
          role="dialog"
          aria-label="{{ block.settings.text }}"
          aria-modal="true"
          class="product-popup-modal__content"
          tabindex="-1"
        >
          <button
            id="ModalClose-{{ block.id }}"
            type="button"
            class="product-popup-modal__toggle"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          <div class="product-popup-modal__content-info">
            <h1 class="h2">{{ block.settings.page.title | escape }}</h1>
            {{ block.settings.page.content }}
          </div>
        </div>
      </modal-dialog>
    {%- endfor -%}

    {%- if product.media.size > 0 -%}
      <script src="{{ 'product-modal.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'media-gallery.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}

    {%- if first_3d_model -%}
      <script type="application/json" id="ProductJSON-{{ product.id }}">
        {{ product.media | where: 'media_type', 'model' | json }}
      </script>
      <script src="{{ 'product-model.js' | asset_url }}" defer></script>
    {%- endif -%}

    {%- liquid
      if product.selected_or_first_available_variant.featured_media
        assign seo_media = product.selected_or_first_available_variant.featured_media
      else
        assign seo_media = product.featured_media
      endif
    -%}

    <script type="application/ld+json">
      {{ product | structured_data | replace: '"category":"Woda perfumowana"', '"category":"Eau de Parfum"' }}
    </script>
    {%- comment -%} AggregateRating from the theme review data (only when this product has reviews) {%- endcomment -%}
    {%- render 'pm-review-stats', product: product, mode: 'jsonld' -%}
  </div>
</product-info>

{%- liquid
  assign pm_has_fm_builder = false
  assign pm_has_offer_bundle = false
  for b in section.blocks
    if b.type == 'atc_bundle_builder' or b.type == 'bundle_builder_2'
      assign pm_has_fm_builder = true
    elsif b.type == 'custom_offer_bundle'
      assign pm_has_offer_bundle = true
    endif
  endfor
-%}
{% if pm_has_fm_builder and product.metafields.custom.choose_your_fragrances_options != blank %}
  {% render 'bundle-builder-modal' %}
{% endif %}
{% if pm_has_offer_bundle %}
  {% render 'custom-offer-bundle-modal' %}
{% endif %}
  
{% render 'schema-breadcrumbs' %}
{% render 'schema-product' %}
{% comment %} {% render 'schema-faq' %} {% endcomment %}

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "inspired_by",
      "name": "Inspired By",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Inspiracja"
        },
        {
          "type": "checkbox",
          "id": "show_retail_price",
          "label": "Show designer price",
          "info": "From the product field custom.original_retail_price. Hidden when the field is empty.",
          "default": true
        },
        {
          "type": "text",
          "id": "retail_label",
          "label": "Designer price label",
          "info": "Empty = \"Cena markowa\" from the theme language file."
        }
      ]
    },
    {
      "type": "designer_price",
      "name": "Designer Price",
      "limit": 1
    },
    {
      "name": "Social Proof Review",
      "type": "social_proof_review",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author name",
          "default": "Hilda"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review text",
          "default": "and 100.000+ others purchased"
        }
      ]
    },
    {
      "type": "press_quotes",
      "name": "Press Quotes Slider",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Item 1"
        },
        {
          "type": "image_picker",
          "id": "image_1",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "text_1",
          "label": "Quote",
          "default": "Anything I've ordered has been amazing and has a long lasting scent"
        },
        {
          "type": "header",
          "content": "Item 2"
        },
        {
          "type": "image_picker",
          "id": "image_2",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Quote",
          "default": "\"We seriously couldn't tell the difference between this and the real deal\""
        },
        {
          "type": "header",
          "content": "Item 3"
        },
        {
          "type": "image_picker",
          "id": "image_3",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Quote",
          "default": "The scent lasts all day and gets compliments every time"
        }
      ]
    },
    {
      "type": "review_slider",
      "name": "Review Slider",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Review 1"
        },
        {
          "type": "text",
          "id": "name_1",
          "label": "Reviewer name",
          "default": "Hilda"
        },
        {
          "type": "textarea",
          "id": "text_1",
          "label": "Review text",
          "default": "Anything I've ordered has been amazing and has a long lasting scent"
        },
        {
          "type": "header",
          "content": "Review 2"
        },
        {
          "type": "text",
          "id": "name_2",
          "label": "Reviewer name",
          "default": "Emma"
        },
        {
          "type": "textarea",
          "id": "text_2",
          "label": "Review text",
          "default": "We seriously couldn't tell the difference between this and the real deal"
        },
        {
          "type": "header",
          "content": "Review 3"
        },
        {
          "type": "text",
          "id": "name_3",
          "label": "Reviewer name",
          "default": "Sofia"
        },
        {
          "type": "textarea",
          "id": "text_3",
          "label": "Review text",
          "default": "The scent lasts all day and gets compliments every time"
        },
        {
          "type": "header",
          "content": "Review 4"
        },
        {
          "type": "text",
          "id": "name_4",
          "label": "Reviewer name"
        },
        {
          "type": "textarea",
          "id": "text_4",
          "label": "Review text"
        },
        {
          "type": "header",
          "content": "Review 5"
        },
        {
          "type": "text",
          "id": "name_5",
          "label": "Reviewer name"
        },
        {
          "type": "textarea",
          "id": "text_5",
          "label": "Review text"
        }
      ]
    },
    {
      "type": "made_in_the_eu",
      "name": "No harsh chemicals",
      "limit": 1
    },
    {
      "type": "scent_intensity",
      "name": "Scent Intensity",
      "limit": 1
    },
    {
      "type": "cheaper_than",
      "name": "Cheaper than",
      "limit": 1,
      "settings": [
        {
          "type": "number",
          "id": "number",
          "label": "Cheaper than amount",
          "default": 250
        }
      ]
    },
    {
      "type": "mobile_gallery",
      "name": "Mobile Gallery",
      "limit": 1
    },
    {
      "type": "reactive_variant_selector",
      "name": "Reactive Variant Selector",
      "limit": 1
    },
    {
      "type": "dialect_notes",
      "name": "Dialect Notes",
      "limit": 1
    },
    {
      "type": "atc_bundle_builder",
      "name": "Atc Bundle Builder",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "collection_handles",
          "label": "Collection Handles",
          "info": "Comma-separated collection handles, e.g. men:Men,women,new:New arrivals. Each collection adds its products to the pool and shows as a filter button. Optional button text goes after a colon; otherwise the collection's \"Filter label\" metafield (custom.filter_label) or its title is used.",
          "default": "best-sellers,new"
        }
      ]
    },
    {
      "type": "magic_perfume_atc",
      "name": "Magic Perfume Atc",
      "limit": 1
    },
    {
      "type": "shipping_text",
      "name": "Shipping Text",
      "limit": 1
    },
    {
      "type": "selling_points",
      "name": "Selling Points",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Editorial layout: shows the product's custom.selling_points metafield as a check-circle list, or the three lines below when the metafield is empty."
        },
        {
          "type": "text",
          "id": "benefit_1",
          "label": "Benefit 1",
          "default": "≈95% scent match, based on verified ratings"
        },
        {
          "type": "text",
          "id": "benefit_2",
          "label": "Benefit 2",
          "default": "Lasts up to 12 hours"
        },
        {
          "type": "text",
          "id": "benefit_3",
          "label": "Benefit 3",
          "default": "Ships next business day"
        }
      ]
    },
    {
      "type": "trust_row",
      "name": "Trust row",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Two halves split by a hairline: a pulsing dot with \"Ships next business day from <warehouse city>\" and a shield with the guarantee text."
        },
        {
          "type": "checkbox",
          "id": "show_shipping",
          "label": "Show the shipping line",
          "default": true
        },
        {
          "type": "inline_richtext",
          "id": "guarantee_text",
          "label": "Guarantee text",
          "default": "<strong>60-day</strong> money-back guarantee"
        },
        {
          "type": "inline_richtext",
          "id": "shipping_text",
          "label": "Delivery text",
          "default": "Dostawa w 48 godzin na terenie Polski"
        }
      ]
    },
    {
      "type": "story_card",
      "name": "Story card (The scent)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Collapsible white card showing the product's custom.scent_description metafield (two lines, opens to the full text). Hidden when the metafield is empty."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "info": "Leave empty to use the translated \"The scent\" label."
        },
        {
          "type": "image_picker",
          "id": "background_image",
          "label": "Background texture (optional)"
        }
      ]
    },
    {
      "type": "bundle_content",
      "name": "Bundle Content",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "link_label",
          "label": "Read more link",
          "info": "Shown after the text; opens the description tab below. Empty = no link.",
          "default": "Czytaj więcej"
        },
        {
          "type": "text",
          "id": "description_block_id",
          "label": "Description tab block ID",
          "info": "ID of the collapsible tab with the full description (e.g. collapsible_tab_FAAFhb)."
        }
      ]
    },
    {
      "type": "bundle_price",
      "name": "Bundle Price",
      "limit": 1
    },
    {
      "type": "bundle_builder_2",
      "name": "Bundle builder 2",
      "limit": 1
    },
    {
      "type": "money_back",
      "name": "Money Back Guarantee",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Money Back Guarantee Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Money Back Guarantee Title",
          "default": "Try it for 60 days, risk-free."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Fewer than 0.5% of buyers use our money-back guarantee."
        }
      ]
    },
    {
      "type": "tsr_block",
      "name": "TSR Block",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    },
    {
      "type": "product_statistics",
      "name": "FM Statistics",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "10,000+ Federico Mahora Bottles Shipped Worldwide",
          "label": "Heading"
        },
        {
          "type": "header",
          "content": "Statistic 1"
        },
        {
          "type": "number",
          "id": "percent_1",
          "default": 99,
          "label": "Percentage"
        },
        {
          "type": "richtext",
          "id": "text_1",
          "default": "<p>Said Federico Mahora <strong>smells just like the designer fragrance</strong>, without the high designer price.</p>",
          "label": "Description",
          "info": "Leave empty to hide this statistic."
        },
        {
          "type": "header",
          "content": "Statistic 2"
        },
        {
          "type": "number",
          "id": "percent_2",
          "default": 96,
          "label": "Percentage"
        },
        {
          "type": "richtext",
          "id": "text_2",
          "default": "<p>of our customers said they'd <strong>switch to Federico Mahora</strong> instead of repurchasing the original.</p>",
          "label": "Description",
          "info": "Leave empty to hide this statistic."
        },
        {
          "type": "header",
          "content": "Statistic 3"
        },
        {
          "type": "number",
          "id": "percent_3",
          "default": 93,
          "label": "Percentage"
        },
        {
          "type": "richtext",
          "id": "text_3",
          "default": "<p>said they <strong>couldn't tell the difference</strong> between Federico Mahora and the original in a blind test.</p>",
          "label": "Description",
          "info": "Leave empty to hide this statistic."
        },
        {
          "type": "header",
          "content": "Statistic 4"
        },
        {
          "type": "number",
          "id": "percent_4",
          "label": "Percentage"
        },
        {
          "type": "richtext",
          "id": "text_4",
          "label": "Description",
          "info": "Leave empty to hide this statistic."
        },
        {
          "type": "header",
          "content": "Footer"
        },
        {
          "type": "text",
          "id": "disclaimer",
          "label": "Disclaimer",
          "info": "Optional. Leave empty to hide."
        }
      ]
    },
    {
      "type": "selling_fast",
      "name": "Selling Out Fast",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Selling out fast",
          "label": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "subheading",
          "default": "Due to high demand, limited quantities available",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "sold_text",
          "default": "[percent]% sold",
          "label": "Sold text",
          "info": "Use [percent] where the percentage should appear."
        },
        {
          "type": "header",
          "content": "Progress"
        },
        {
          "type": "range",
          "id": "percent_min",
          "min": 1,
          "max": 99,
          "step": 1,
          "unit": "%",
          "default": 8,
          "label": "Minimum sold percentage"
        },
        {
          "type": "range",
          "id": "percent_max",
          "min": 1,
          "max": 99,
          "step": 1,
          "unit": "%",
          "default": 95,
          "label": "Maximum sold percentage"
        },
        {
          "type": "header",
          "content": "Countdown"
        },
        {
          "type": "checkbox",
          "id": "show_countdown",
          "default": true,
          "label": "Show countdown"
        },
        {
          "type": "text",
          "id": "countdown_label",
          "default": "Ends in",
          "label": "Countdown label"
        },
        {
          "type": "text",
          "id": "end_time",
          "label": "End date and time",
          "info": "Format: YYYY-MM-DD HH:MM (for example 2026-12-24 18:00). Leave empty to end at midnight + 12 hours, which resets every day."
        },
        {
          "type": "header",
          "content": "Colors"
        },
        {
          "type": "color",
          "id": "bar_color",
          "default": "#cf8195",
          "label": "Progress bar"
        },
        {
          "type": "color",
          "id": "track_color",
          "default": "#f7e4e8",
          "label": "Progress bar background"
        },
        {
          "type": "color",
          "id": "accent_color",
          "default": "#cf8195",
          "label": "Countdown text"
        }
      ]
    },
    {
      "type": "afterpay",
      "name": "Afterpay",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "4 interest-free payments of <strong>$10</strong> with",
          "label": "Text",
          "info": "Shown before the Afterpay logo."
        }
      ]
    },
    {
      "type": "people_purchased",
      "name": "People Purchased",
      "limit": 1
    },
    {
      "type": "cta_review",
      "name": "CTA Review",
      "limit": 1
    },
    {
      "type": "expanded_notes",
      "name": "Expanded Notes",
      "limit": 1
    },
    {
      "type": "videos",
      "name": "Videos",
      "limit": 1,
      "settings": [
        {
          "type": "video",
          "id": "video1",
          "label": "Video 1"
        },
        {
          "type": "image_picker",
          "id": "video_poster_1",
          "label": "Video Poster 1"
        },
        {
          "type": "video",
          "id": "video2",
          "label": "Video 2"
        },
        {
          "type": "image_picker",
          "id": "video_poster_2",
          "label": "Video Poster 2"
        },
        {
          "type": "video",
          "id": "video3",
          "label": "Video 3"
        },
        {
          "type": "image_picker",
          "id": "video_poster_3",
          "label": "Video Poster 3"
        },
        {
          "type": "video",
          "id": "video4",
          "label": "Video 4"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.main-product.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "t:sections.main-product.blocks.text.settings.text.default",
          "label": "t:sections.main-product.blocks.text.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.text.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.text.settings.text_style.label"
        }
      ]
    },
    {
      "type": "custom_rating_text",
      "name": "Custom Rating Text",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "4.9/5 Rated (3,926 Reviews)",
          "label": "Custom Rating Text"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating value (screen readers)",
          "info": "Editorial layout only: read as \"Rated X out of 5\" next to the five stars.",
          "default": "4.9"
        }
      ]
    },
    {
      "type": "title",
      "name": "t:sections.main-product.blocks.title.name",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.main-product.blocks.price.name",
      "limit": 1
    },
    {
      "type": "sku",
      "name": "t:sections.main-product.blocks.sku.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.sku.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.sku.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.sku.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.sku.settings.text_style.label"
        }
      ]
    },
    {
      "type": "inventory",
      "name": "t:sections.main-product.blocks.inventory.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "body",
              "label": "t:sections.main-product.blocks.inventory.settings.text_style.options__1.label"
            },
            {
              "value": "subtitle",
              "label": "t:sections.main-product.blocks.inventory.settings.text_style.options__2.label"
            },
            {
              "value": "uppercase",
              "label": "t:sections.main-product.blocks.inventory.settings.text_style.options__3.label"
            }
          ],
          "default": "body",
          "label": "t:sections.main-product.blocks.inventory.settings.text_style.label"
        },
        {
          "type": "range",
          "id": "inventory_threshold",
          "label": "t:sections.main-product.blocks.inventory.settings.inventory_threshold.label",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10
        },
        {
          "type": "checkbox",
          "id": "show_inventory_quantity",
          "label": "t:sections.main-product.blocks.inventory.settings.show_inventory_quantity.label",
          "default": true
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "t:sections.main-product.blocks.quantity_selector.name",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.main-product.blocks.variant_picker.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            {
              "value": "dropdown",
              "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__1.label"
            },
            {
              "value": "button",
              "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.options__2.label"
            }
          ],
          "default": "button",
          "label": "t:sections.main-product.blocks.variant_picker.settings.picker_type.label"
        },
        {
          "id": "swatch_shape",
          "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.label",
          "type": "select",
          "info": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.info",
          "options": [
            {
              "value": "circle",
              "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.options__1.label"
            },
            {
              "value": "square",
              "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.options__2.label"
            },
            {
              "value": "none",
              "label": "t:sections.main-product.blocks.variant_picker.settings.swatch_shape.options__3.label"
